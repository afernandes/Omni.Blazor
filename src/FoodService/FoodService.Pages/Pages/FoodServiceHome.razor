@page "/"
@layout FoodServiceLandingLayout

<PageTitle>FoodService — Exemplo Omni.Blazor</PageTitle>

<main class="fs-home">
    <header class="fs-home-nav">
        <OmniBrand Initial="F" Name="FoodService" Tenant="Omni.Blazor sample" Href="/" />
        <div>
            <OmniThemePicker Title="Aparência" />
            <a href="https://github.com/afernandes/Omni.Blazor/tree/main/src/FoodService">Ver código</a>
        </div>
    </header>

    <section class="fs-home-hero" aria-labelledby="fs-home-title">
        <div>
            <span class="fs-home-kicker">EXEMPLO VERTICAL · FOOD SERVICE</span>
            <h1 id="fs-home-title">Componentes reais em uma operação completa.</h1>
            <p>
                Explore duas experiências independentes construídas com Omni.Blazor:
                uma frente de caixa operacional e um cardápio digital voltado ao cliente.
            </p>
        </div>
        <div class="fs-home-status">
            <OmniStatusBadge Label="Interactive Server" Kind="StatusBadgeKind.Good" Pulse />
            <span>.NET 10 · dados demonstrativos</span>
        </div>
    </section>

    <section class="fs-home-experiences" aria-label="Experiências disponíveis">
        <a class="fs-experience fs-experience-pdv" href="/pdv">
            <div class="fs-experience-top">
                <span class="fs-experience-icon"><OmniIcon Name="shopping-cart" /></span>
                <span class="fs-experience-number">01</span>
            </div>
            <div class="fs-experience-copy">
                <span class="fs-home-kicker">OPERAÇÃO</span>
                <h2>PDV completo</h2>
                <p>
                    Carrinho, cliente, modos de atendimento, pizzas meio a meio,
                    ajustes, atalhos de teclado e finalização de pedido.
                </p>
            </div>
            <span class="fs-experience-link">Abrir PDV <OmniIcon Name="arrow-right" Size="ComponentSize.Sm" /></span>
            <div class="fs-pdv-preview" aria-hidden="true">
                <i></i><i></i><i></i><i></i><i></i>
            </div>
        </a>

        <a class="fs-experience fs-experience-menu" href="/cardapio">
            <div class="fs-experience-top">
                <span class="fs-experience-icon"><OmniIcon Name="grid" /></span>
                <span class="fs-experience-number">02</span>
            </div>
            <div class="fs-experience-copy">
                <span class="fs-home-kicker">CLIENTE</span>
                <h2>Cardápio digital</h2>
                <p>
                    Jornada mobile-first com sabores, tamanhos, personalização,
                    carrinho, checkout e acompanhamento do pedido.
                </p>
            </div>
            <span class="fs-experience-link">Abrir cardápio <OmniIcon Name="arrow-right" Size="ComponentSize.Sm" /></span>
            <div class="fs-menu-preview" aria-hidden="true">
                <span></span><span></span><span></span>
            </div>
        </a>
    </section>

    <footer class="fs-home-footer">
        <span>PROJETO INDEPENDENTE EM <code>src/FoodService</code></span>
        <span>CONSTRUÍDO COM OMNI.BLAZOR</span>
    </footer>
</main>
