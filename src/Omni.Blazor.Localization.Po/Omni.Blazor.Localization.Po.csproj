<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Omni.Blazor.Localization.Po</RootNamespace>
    <AssemblyName>Omni.Blazor.Localization.Po</AssemblyName>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PackageId>AndersonN.Omni.Blazor.Localization.Po</PackageId>
    <Title>Omni.Blazor PO/Gettext localization</Title>
    <Description>Optional Orchard Core PO/Gettext adapter for Omni.Blazor localization.</Description>
    <PackageTags>blazor;localization;i18n;po;gettext;orchardcore;omni</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Omni.Blazor\Omni.Blazor.csproj" />
    <PackageReference Include="OrchardCore.Localization.Core" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
