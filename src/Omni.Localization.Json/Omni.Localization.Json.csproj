<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Omni.Localization.Json</RootNamespace>
    <AssemblyName>Omni.Localization.Json</AssemblyName>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnablePackageValidation>true</EnablePackageValidation>
    <IsAotCompatible>true</IsAotCompatible>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PackageId>AndersonN.Omni.Localization.Json</PackageId>
    <Title>Omni.Localization JSON catalogs</Title>
    <Description>Strict JSON catalogs with nested keys and deterministic merging for AndersonN.Omni.Localization.</Description>
    <PackageTags>localization;i18n;json;dotnet;omni</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Omni.Localization\Omni.Localization.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
