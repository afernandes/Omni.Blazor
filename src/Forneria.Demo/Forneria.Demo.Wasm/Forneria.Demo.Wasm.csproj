<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Localization" />
  </ItemGroup>

  <ItemGroup>
    <!-- Mono WebAssembly Debug aborts while resolving compiler-generated Razor metadata
         across the 162-page route catalog. Keep the host debuggable, but compile the shared
         page assembly with Release codegen; its portable PDB is still copied to the host. -->
    <ProjectReference Include="..\Forneria.Demo.Pages\Forneria.Demo.Pages.csproj"
                      AdditionalProperties="Configuration=Release" />
    <ProjectReference Include="..\..\Omni.Blazor\Omni.Blazor.csproj" />
  </ItemGroup>

</Project>
