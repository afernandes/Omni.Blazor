@page "/not-found"
@layout MarketingLayout

<PageTitle>Page not found — Omni.Blazor</PageTitle>

<OmniHero Title="Page not found"
           Subtitle="The requested route does not exist or has moved. Return home or explore the component catalog.">
    <EyebrowContent>
        <OmniEyebrow Text="ERROR 404" />
    </EyebrowContent>
    <CtaContent>
        <a href="" class="omni-btn omni-btn-primary omni-btn-lg">
            <span>Back to home</span>
        </a>
        <a href="showcase/buttons" class="omni-btn omni-btn-lg">
            <span>Browse components</span>
        </a>
    </CtaContent>
</OmniHero>
