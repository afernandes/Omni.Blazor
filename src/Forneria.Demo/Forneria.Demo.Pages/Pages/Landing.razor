@page "/"
@layout MarketingLayout

<PageTitle>Omni.Blazor — Components for .NET 10</PageTitle>

<div class="demo-landing">
    <section class="demo-hero" aria-labelledby="demo-hero-title">
        <div class="demo-hero-copy">
            <div class="demo-kicker">
                <span class="demo-live-dot" aria-hidden="true"></span>
                <span>202 components · .NET 10 · Server &amp; WebAssembly</span>
            </div>

            <h1 id="demo-hero-title">
                Build Blazor products<br />
                that feel <span>finished.</span>
            </h1>

            <p class="demo-hero-lead">
                A production-minded component system for data-heavy applications,
                polished workflows and accessible interfaces — with one coherent API,
                one token layer and no visual guesswork.
            </p>

            <div class="demo-hero-actions">
                <a class="demo-cta demo-cta-primary" href="showcase">
                    Browse all components
                    <OmniIcon Name="arrow-right" Size="ComponentSize.Sm" />
                </a>
                <a class="demo-cta demo-cta-secondary" href="showcase/get-started">
                    <OmniIcon Name="code" Size="ComponentSize.Sm" />
                    Get started
                </a>
            </div>

            <div class="demo-trust-row" aria-label="Project qualities">
                <span><OmniIcon Name="check" Size="ComponentSize.Sm" /> Typed APIs</span>
                <span><OmniIcon Name="check" Size="ComponentSize.Sm" /> Accessible by default</span>
                <span><OmniIcon Name="check" Size="ComponentSize.Sm" /> NuGet ready</span>
            </div>
        </div>

        <div class="demo-stage" aria-label="Live Omni.Blazor component composition">
            <div class="demo-stage-glow" aria-hidden="true"></div>
            <div class="demo-window">
                <div class="demo-window-bar">
                    <div class="demo-window-dots" aria-hidden="true"><i></i><i></i><i></i></div>
                    <span>workspace.razor</span>
                    <OmniStatusBadge Label="Live" Kind="StatusBadgeKind.Good" Pulse />
                </div>

                <div class="demo-window-body">
                    <aside class="demo-preview-nav" aria-hidden="true">
                        <div class="demo-preview-brand">O</div>
                        <span class="active"><OmniIcon Name="layout-dashboard" /></span>
                        <span><OmniIcon Name="database" /></span>
                        <span><OmniIcon Name="calendar" /></span>
                        <span><OmniIcon Name="bar-chart" /></span>
                    </aside>

                    <div class="demo-preview-main">
                        <div class="demo-preview-heading">
                            <div>
                                <small>OVERVIEW</small>
                                <strong>Release workspace</strong>
                            </div>
                            <OmniAvatarGroup More="4" Size="AvatarSize.Sm">
                                <OmniAvatar Initials="AF" Size="AvatarSize.Sm" />
                                <OmniAvatar Initials="LM" Size="AvatarSize.Sm" />
                                <OmniAvatar Initials="JS" Size="AvatarSize.Sm" />
                            </OmniAvatarGroup>
                        </div>

                        <div class="demo-preview-stats">
                            <OmniStat Label="Coverage" Value="94%" Delta="+3.2%" Card />
                            <OmniStat Label="Components" Value="202" Delta="stable" Card />
                            <OmniStat Label="Build" Value="0 warnings" Delta="ready" Card />
                        </div>

                        <OmniCard Elevated>
                            <HeaderContent>
                                <div class="demo-card-heading">
                                    <strong>Release readiness</strong>
                                    <span>Typed forms, data and overlays</span>
                                </div>
                            </HeaderContent>
                            <HeaderActions>
                                <OmniStatusBadge Label="On track" Kind="StatusBadgeKind.Accent" />
                            </HeaderActions>
                            <ChildContent>
                                <div class="demo-readiness-row">
                                    <span>API and interaction checks</span>
                                    <strong>82%</strong>
                                </div>
                                <OmniProgress Value="82" />
                                <div class="demo-readiness-list">
                                    <span><OmniIcon Name="check" Size="ComponentSize.Sm" /> DataGrid flows</span>
                                    <span><OmniIcon Name="check" Size="ComponentSize.Sm" /> Form validation</span>
                                    <span><OmniIcon Name="check" Size="ComponentSize.Sm" /> Keyboard navigation</span>
                                </div>
                            </ChildContent>
                        </OmniCard>

                        <OmniAlert Severity="NotificationSeverity.Success" Title="Ready to ship">
                            All quality gates passed in Server and WebAssembly.
                        </OmniAlert>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <div class="demo-marquee" aria-hidden="true">
        <div class="demo-marquee-track">
            <span>DATA GRID</span><i></i><span>DATA FORM</span><i></i><span>SCHEDULER</span><i></i>
            <span>ENTITY PICKER</span><i></i><span>DIAGRAM</span><i></i><span>FILE MANAGER</span><i></i>
            <span>DATA GRID</span><i></i><span>DATA FORM</span><i></i><span>SCHEDULER</span><i></i>
            <span>ENTITY PICKER</span><i></i><span>DIAGRAM</span><i></i><span>FILE MANAGER</span><i></i>
        </div>
    </div>

    <section id="components" class="demo-section" aria-labelledby="demo-components-title">
        <div class="demo-section-heading">
            <div>
                <span class="demo-section-kicker">FLAGSHIP WORKFLOWS</span>
                <h2 id="demo-components-title">More than controls. Complete product patterns.</h2>
            </div>
            <a href="showcase">Explore the catalog <OmniIcon Name="arrow-right" Size="ComponentSize.Sm" /></a>
        </div>

        <div class="demo-feature-grid">
            <a class="demo-feature demo-feature-large" href="showcase/data-grid-form">
                <div class="demo-feature-icon"><OmniIcon Name="database" /></div>
                <span class="demo-feature-label">DATA WORKFLOWS</span>
                <h3>DataGrid + DataForm</h3>
                <p>Typed CRUD schemas, validation, overlays, provider mode and bulk actions in one composable workflow.</p>
                <div class="demo-feature-visual demo-grid-visual" aria-hidden="true">
                    <span></span><span></span><span></span><span></span><span></span><span></span>
                </div>
            </a>

            <a class="demo-feature" href="showcase/data-form">
                <div class="demo-feature-icon"><OmniIcon Name="edit" /></div>
                <span class="demo-feature-label">FORMS</span>
                <h3>Metadata-driven forms</h3>
                <p>Fluent typed builders, responsive groups, collections and extensible editor registries.</p>
                <span class="demo-feature-link">Open DataForm <OmniIcon Name="arrow-right" Size="ComponentSize.Sm" /></span>
            </a>

            <a class="demo-feature" href="showcase/entity-picker">
                <div class="demo-feature-icon"><OmniIcon Name="search" /></div>
                <span class="demo-feature-label">SELECTION</span>
                <h3>Entity Picker</h3>
                <p>Local or remote entity discovery with typed keys, selection state and accessible dialogs.</p>
                <span class="demo-feature-link">Open Entity Picker <OmniIcon Name="arrow-right" Size="ComponentSize.Sm" /></span>
            </a>

            <a class="demo-feature" href="showcase/diagram">
                <div class="demo-feature-icon"><OmniIcon Name="workflow" /></div>
                <span class="demo-feature-label">ADVANCED UI</span>
                <h3>Diagram Canvas</h3>
                <p>Interactive nodes, ports and connectors for workflow editors and visual tooling.</p>
                <span class="demo-feature-link">Open Diagram <OmniIcon Name="arrow-right" Size="ComponentSize.Sm" /></span>
            </a>

            <a class="demo-feature" href="showcase/data-import">
                <div class="demo-feature-icon"><OmniIcon Name="upload" /></div>
                <span class="demo-feature-label">DATA ENTRY</span>
                <h3>Typed data import</h3>
                <p>Upload, map, validate, preview and commit tabular data through a guided pipeline.</p>
                <span class="demo-feature-link">Open Data Import <OmniIcon Name="arrow-right" Size="ComponentSize.Sm" /></span>
            </a>
        </div>
    </section>

    <section id="quality" class="demo-section demo-quality" aria-labelledby="demo-quality-title">
        <div class="demo-quality-copy">
            <span class="demo-section-kicker">ENGINEERED FOR REAL PRODUCTS</span>
            <h2 id="demo-quality-title">A component library should reduce risk, not just markup.</h2>
            <p>
                Omni.Blazor treats lifecycle, cancellation, keyboard behavior, responsive layout,
                theme consistency and packaging as part of the component contract.
            </p>
            <a class="demo-text-link" href="showcase/get-started">Read the setup guide <OmniIcon Name="arrow-right" Size="ComponentSize.Sm" /></a>
        </div>

        <div class="demo-quality-grid">
            <article>
                <OmniIcon Name="shield" />
                <strong>Lifecycle safe</strong>
                <span>Deterministic disposal, cancellable async work and observable failures.</span>
            </article>
            <article>
                <OmniIcon Name="zap" />
                <strong>Performance aware</strong>
                <span>Virtualization, bounded caches and allocation-conscious hot paths where measured.</span>
            </article>
            <article>
                <OmniIcon Name="eye" />
                <strong>Accessible</strong>
                <span>Semantic controls, focus management, keyboard navigation and reduced motion.</span>
            </article>
            <article>
                <OmniIcon Name="package" />
                <strong>Package ready</strong>
                <span>NuGet, static assets, generated API manifests and MCP discovery.</span>
            </article>
        </div>
    </section>

    <section class="demo-section demo-start" aria-labelledby="demo-start-title">
        <div>
            <span class="demo-section-kicker">START IN MINUTES</span>
            <h2 id="demo-start-title">One package. One service registration. One theme.</h2>
            <p>Use the same component surface in Interactive Server and standalone WebAssembly.</p>
            <div class="demo-start-actions">
                <a class="demo-cta demo-cta-primary" href="showcase/get-started">Installation guide</a>
                <a class="demo-cta demo-cta-secondary" href="https://github.com/afernandes/Omni.Blazor">View on GitHub</a>
            </div>
        </div>
        <pre aria-label="Omni.Blazor installation example"><code><span>dotnet add package</span> AndersonN.Omni.Blazor

<strong>builder.Services.AddOmniComponents();</strong>

&lt;OmniTheme Accent="amber" /&gt;</code></pre>
    </section>

    <section id="examples" class="demo-section demo-example" aria-labelledby="demo-example-title">
        <div class="demo-example-mark" aria-hidden="true">FS</div>
        <div>
            <span class="demo-section-kicker">VERTICAL SAMPLE</span>
            <h2 id="demo-example-title">See Omni.Blazor inside a complete FoodService experience.</h2>
            <p>
                The operational PDV and customer-facing digital menu live in their own
                independent sample project, keeping this catalog focused while preserving the real-world screens.
            </p>
        </div>
        <a class="demo-cta demo-cta-secondary" href="https://github.com/afernandes/Omni.Blazor/tree/main/src/FoodService">
            Open FoodService sample
            <OmniIcon Name="arrow-right" Size="ComponentSize.Sm" />
        </a>
    </section>
</div>
