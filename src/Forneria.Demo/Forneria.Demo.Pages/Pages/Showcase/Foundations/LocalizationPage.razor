@page "/showcase/localization"
@attribute [ShowcaseInfo(Title = "Localization & RTL", Category = Cat.Overview, Icon = "globe", Order = 2, Aliases = "i18n,culture,resx,po,gettext,rtl,idioma,tradução")]
@layout ShowcaseLayout
@using System.Globalization

<PageTitle>Localization & RTL — Omni.Blazor</PageTitle>

<ShowcasePage Title="Localization & RTL"
              Subtitle="Traduções extensíveis, formatação por cultura, pluralização e direção RTL.">
    <Overview>
        <p>
            A biblioteca inclui catálogos completos em <strong>pt-BR</strong> e <strong>inglês</strong>.
            Idiomas da aplicação podem vir de RESX, JSON/dicionário, banco ou PO/Gettext por meio de
            <code>IOmniTranslationProvider</code> e <code>IStringLocalizer</code>.
        </p>
        <p>
            Cada painel abaixo renderiza os mesmos componentes com cultura própria. Francês e árabe
            são catálogos pequenos registrados pelo projeto demo; chaves ausentes mantêm o fallback seguro.
        </p>
    </Overview>

    <ChildContent>
        <ShowcaseSection Title="Culturas independentes no mesmo render"
                         Description="OmniCultureScope separa Culture (formatação) de UICulture (textos) e define lang/dir.">
            <div class="omni-grid omni-grid-3">
                <LocalizationCultureCard CultureName="pt-BR" Title="Português" Date="@_sampleDate" />
                <LocalizationCultureCard CultureName="en-US" Title="English" Date="@_sampleDate" />
                <LocalizationCultureCard CultureName="fr-FR" Title="Français — catálogo da aplicação" Date="@_sampleDate" />
            </div>
        </ShowcaseSection>

        <ShowcaseSection Title="RTL inferido pela cultura"
                         Description="A cultura ar-SA produz dir=rtl; os controles continuam usando a mesma API.">
            <OmniCultureScope Culture="@_arabicCulture"
                              UICulture="@_arabicCulture"
                              Class="omni-card omni-stack">
                <div class="omni-eyebrow">العربية · ar-SA · RTL</div>
                <OmniDatePicker TValue="DateTime?" Value="@_date" ShowTime Clearable="false" />
                <OmniChat Height="250px" ShowClearButton="false" />
            </OmniCultureScope>
        </ShowcaseSection>

        <ShowcaseSection Title="Adicionar um idioma sem recompilar a biblioteca"
                         Description="O catálogo é copiado para um FrozenDictionary e participa da cadeia de fallback."
                         Code="@DictionaryExample">
            <p class="omni-muted">
                Use <code>AddOmniStringLocalizer&lt;SharedResources&gt;()</code> para RESX ou para um
                provider PO que implemente o pipeline padrão do .NET. Veja o guia completo em
                <code>docs/localization.md</code>.
            </p>
        </ShowcaseSection>
    </ChildContent>
</ShowcasePage>

@code {
    private readonly DateTime? _date = new(2026, 8, 12, 14, 30, 0);
    private readonly DateTime _sampleDate = new(2026, 8, 12, 14, 30, 0);
    private readonly CultureInfo _arabicCulture = CultureInfo.GetCultureInfo("ar-SA");

    private const string DictionaryExample = @"builder.Services.AddOmniTranslations(""fr-FR"", new Dictionary<string, string>
{
    [OmniTranslationKeys.Close] = ""Fermer"",
    [OmniTranslationKeys.Save] = ""Enregistrer"",
    [""DateRangeSummary.One""] = ""{0} → {1} · {2} jour"",
    [""DateRangeSummary.Other""] = ""{0} → {1} · {2} jours""
});
builder.Services.AddOmniComponents();";
}
