@using Forneria.Demo.Pages.Services
@inherits DataGridExamplesBase
@inject NotificationService Toast

<ShowcaseSection Title="EmptyTemplate + LoadingTemplate"
                 Description="Slots customizáveis pro empty state (ícone + texto + CTA) e pro loading (skeleton rows em vez do spinner). Toggle pra ver cada estado."
                 Code="@(@"<OmniDataGrid TItem=""Order"" Data=""@Orders"" Loading=""@loading"" LoadingSkeleton>
    <Columns>...</Columns>
    <EmptyTemplate>
        <p>Nenhum pedido por aqui</p>
    </EmptyTemplate>
</OmniDataGrid>")">
    <div class="omni-stack omni-stack-12">
        <div class="omni-stack" style="flex-direction: row; gap: 8px;">
            <OmniButton Variant="@(_emptyDemoState == 0 ? ButtonVariant.Primary : ButtonVariant.Default)"
                        Size="ComponentSize.Sm" Text="Com dados" OnClick="ShowData" />
            <OmniButton Variant="@(_emptyDemoState == 1 ? ButtonVariant.Primary : ButtonVariant.Default)"
                        Size="ComponentSize.Sm" Text="Vazio (EmptyTemplate)" OnClick="ShowEmpty" />
            <OmniButton Variant="@(_emptyDemoState == 2 ? ButtonVariant.Primary : ButtonVariant.Default)"
                        Size="ComponentSize.Sm" Text="Carregando (Skeleton)" OnClick="ShowLoading" />
        </div>
        <OmniDataGrid TItem="Order"
                      Data="@(_emptyDemoState == 1 ? Array.Empty<Order>() : Orders.AllOrders.Take(12))"
                      Loading="@(_emptyDemoState == 2)"
                      AllowPaging PageSize="6"
                      LoadingSkeleton>
            <Columns>
                <OmniDataGridColumn TItem="Order" Title="Pedido #" Property="@(order => (object)order.Numero)" Width="120px">
                    <Template><span class="omni-mono">#@context.Numero</span></Template>
                </OmniDataGridColumn>
                <OmniDataGridColumn TItem="Order" Title="Cliente" Property="@(order => order.Cliente)" />
                <OmniDataGridColumn TItem="Order" Title="Status" Property="@(order => order.Status)">
                    <Template><OmniBadge Text="@context.Status" Variant="@StatusVariant(context.Status)" /></Template>
                </OmniDataGridColumn>
                <OmniDataGridColumn TItem="Order" Title="Total" Property="@(order => (object)order.Total)">
                    <Template><span class="omni-mono">@context.Total.ToString("C", PtBr)</span></Template>
                </OmniDataGridColumn>
            </Columns>
            <EmptyTemplate>
                <div class="omni-stack omni-stack-8" style="padding: 48px 24px; text-align: center; align-items: center;">
                    <OmniIcon Name="inbox" />
                    <h3 style="margin: 0;">Nenhum pedido por aqui</h3>
                    <p class="omni-muted" style="margin: 0;">Crie seu primeiro pedido pra começar.</p>
                    <OmniButton Text="Criar pedido" Icon="plus" Variant="ButtonVariant.Primary" Size="ComponentSize.Sm"
                                OnClick="OnEmptyCtaClick" />
                </div>
            </EmptyTemplate>
        </OmniDataGrid>
    </div>
</ShowcaseSection>
