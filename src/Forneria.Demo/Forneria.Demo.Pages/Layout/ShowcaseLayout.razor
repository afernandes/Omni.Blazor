@inherits LayoutComponentBase
@layout DemoShellLayout
@implements IDisposable
@using Forneria.Demo.Pages.Layout
@using Omni.Blazor.Models
@using Microsoft.AspNetCore.Components.Routing
@inject Microsoft.AspNetCore.Components.NavigationManager Nav
@inject ScrollManager Scroll

@* Component browser. Nav is auto-built from every routable /showcase page (ShowcaseCatalog):
   categories are collapsible; live filter (accent-insensitive + synonyms); per-category
   counts; "Novo" badges;
   and ⌘K jumps to any component. Styles live in ShowcaseLayout.razor.css (CSS isolation). *@

<div class="sc-shell">
    <OmniSplitView AsideSize="ComponentSize.Lg">
        <AsideContent>
            <div class="sc-aside">
                <div class="sc-aside-head">
                    <div class="sc-aside-search">
                        <OmniIcon Name="search" Size="ComponentSize.Sm" />
                        <input type="search" value="@_query" @oninput="OnSearch"
                               placeholder="Filtrar componentes…  (⌘K p/ pular)" aria-label="Filtrar componentes"
                               autocomplete="off" spellcheck="false" />
                        @if (_query.Length > 0)
                        {
                            <button type="button" class="sc-aside-clear" @onclick="Clear" aria-label="Limpar">
                                <OmniIcon Name="x" Size="ComponentSize.Sm" />
                            </button>
                        }
                    </div>
                    <div class="sc-aside-count">
                        @if (_query.Length == 0)
                        {
                            <span><strong>@ShowcaseCatalog.All.Count</strong> componentes</span>
                        }
                        else
                        {
                            <span><strong>@_matchedCount</strong> de @ShowcaseCatalog.All.Count</span>
                        }
                    </div>
                </div>

                <div class="sc-aside-list">
                    @{ var groups = VisibleGroups(); }
                    @if (groups.Count == 0)
                    {
                        <div class="sc-aside-empty">
                            <OmniIcon Name="search" />
                            <span>Nenhum componente para “@_query”.</span>
                        </div>
                    }
                    else
                    {
                        @foreach (var group in groups)
                        {
                            var cat = group.Category;
                            var collapsed = _query.Length == 0 && _collapsed.Contains(cat);
                            <button type="button" class="sc-cat" @onclick="@(() => ToggleCat(cat))" aria-expanded="@(!collapsed)">
                                <OmniIcon Name="@(collapsed ? "chevron-right" : "chevron-down")" Size="ComponentSize.Sm" />
                                <span class="sc-cat-name">@cat</span>
                                <span class="sc-cat-count">@(CategoryTotals.GetValueOrDefault(cat))</span>
                            </button>
                            @if (!collapsed)
                            {
                                <OmniPanelMenu>
                                    @foreach (var row in group.Rows)
                                    {
                                        var link = row.Link;
                                        var linkMatch = link.Path == "/showcase" ? NavLinkMatch.All : NavLinkMatch.Prefix;
                                        <OmniPanelMenuItem Text="@link.Title" Icon="@link.Icon" Path="@link.Href"
                                                           Match="@linkMatch" Class="@row.CssClass"
                                                           CountText="@link.BadgeText" CountKind="@link.BadgeKind" />
                                    }
                                </OmniPanelMenu>
                            }
                        }
                    }
                </div>
            </div>
        </AsideContent>
        <ChildContent>
            @Body
        </ChildContent>
    </OmniSplitView>
</div>

@* ⌘K / Ctrl+K — jump to any of the discovered components. *@
@if (!DemoRuntime.AvoidWasmDebugStartupInterop)
{
    <OmniCommandPalette Commands="_commands" HistoryKey="showcase" />
}

@code {
    // ── navigation model (computed once from the catalog) ──────────────────
    private static readonly Dictionary<string, string> ParentOf = BuildParents();
    private static readonly List<ShowcaseLink> Roots = BuildRoots();
    private static readonly Dictionary<string, List<ShowcaseLink>> ChildrenOf = BuildChildren();
    private static readonly Dictionary<string, int> CategoryTotals = BuildCategoryTotals();

    // Keep static initialization delegate-free. Mono WebAssembly Debug can abort while
    // resolving the compiler-generated lambda type immediately after the reflection-built
    // catalog initializes. Equivalent loops are deterministic on Server, WASM Debug and
    // trimmed Release builds.
    private static List<ShowcaseLink> BuildRoots()
    {
        var roots = new List<ShowcaseLink>();
        foreach (var link in ShowcaseCatalog.All)
            if (!ParentOf.ContainsKey(link.Path)) roots.Add(link);
        return roots;
    }

    private static Dictionary<string, List<ShowcaseLink>> BuildChildren()
    {
        var children = new Dictionary<string, List<ShowcaseLink>>(StringComparer.OrdinalIgnoreCase);
        foreach (var link in ShowcaseCatalog.All)
        {
            if (!ParentOf.TryGetValue(link.Path, out var parent)) continue;
            if (!children.TryGetValue(parent, out var siblings))
            {
                siblings = [];
                children[parent] = siblings;
            }
            siblings.Add(link);
        }
        return children;
    }

    private static Dictionary<string, int> BuildCategoryTotals()
    {
        var totals = new Dictionary<string, int>(StringComparer.Ordinal);
        foreach (var link in ShowcaseCatalog.All)
            totals[link.Category] = totals.GetValueOrDefault(link.Category) + 1;
        return totals;
    }

    private static Dictionary<string, string> BuildParents()
    {
        var paths = new List<string>(ShowcaseCatalog.All.Count);
        foreach (var link in ShowcaseCatalog.All) paths.Add(link.Path);
        var map = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        foreach (var path in paths)
        {
            string? best = null;
            foreach (var p in paths)
            {
                if (string.Equals(p, "/showcase", StringComparison.OrdinalIgnoreCase)) continue;
                if (string.Equals(p, path, StringComparison.OrdinalIgnoreCase)) continue;
                if (path.StartsWith(p + "/", StringComparison.OrdinalIgnoreCase) && (best is null || p.Length > best.Length))
                    best = p;
            }
            if (best is not null) map[path] = best;
        }
        return map;
    }

    // ── state ────────────────────────────────────────────────────────────────
    private OmniCommand[] _commands = [];
    private string _query = "";
    private HashSet<string>? _visible;                       // null = show everything
    private int _matchedCount = ShowcaseCatalog.All.Count;
    private readonly HashSet<string> _collapsed = new(StringComparer.OrdinalIgnoreCase);
    private bool _scrollPending;

    protected override void OnInitialized()
    {
        var commands = new List<OmniCommand>(ShowcaseCatalog.All.Count);
        foreach (var link in ShowcaseCatalog.All)
        {
            var action = new ShowcaseNavigationAction(Nav, link.Href);
            commands.Add(new OmniCommand(link.Title, action.ExecuteAsync)
            {
                Category = link.Category,
                Icon = link.Icon
            });
        }
        _commands = commands.ToArray();
        if (!DemoRuntime.AvoidWasmDebugStartupInterop)
            Nav.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _scrollPending = true;
        InvokeAsync(StateHasChanged);
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (DemoRuntime.AvoidWasmDebugStartupInterop || (!firstRender && !_scrollPending))
            return Task.CompletedTask;

        _scrollPending = false;
        // ScrollManager contains the no-JS fallback. Returning its task directly keeps this
        // Razor layout free of the async state-machine metadata that aborts Mono WASM Debug.
        return Scroll.ScrollIntoViewAsync(
            ".sc-aside-list .omni-active",
            ScrollBehavior.Smooth,
            ScrollBlock.Nearest).AsTask();
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;

    // ── filter ─────────────────────────────────────────────────────────────────
    private void OnSearch(ChangeEventArgs e) { _query = e.Value?.ToString() ?? ""; Recompute(); }
    private void Clear() { _query = ""; Recompute(); }
    private void ToggleCat(string cat) { if (!_collapsed.Remove(cat)) _collapsed.Add(cat); }

    private void Recompute()
    {
        var q = _query.Trim();
        if (q.Length == 0) { _visible = null; _matchedCount = ShowcaseCatalog.All.Count; return; }

        var matched = new List<ShowcaseLink>();
        foreach (var link in ShowcaseCatalog.All)
            if (Matches(link, q)) matched.Add(link);
        _matchedCount = matched.Count;

        var vis = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        foreach (var m in matched)
        {
            vis.Add(m.Path);
            for (var p = ParentOf.GetValueOrDefault(m.Path); p is not null; p = ParentOf.GetValueOrDefault(p))
                vis.Add(p);
            foreach (var d in ShowcaseCatalog.All)
                if (d.Path.StartsWith(m.Path + "/", StringComparison.OrdinalIgnoreCase)) vis.Add(d.Path);
        }
        _visible = vis;
    }

    private bool IsVisible(ShowcaseLink l) => _visible is null || _visible.Contains(l.Path);
    private List<VisibleShowcaseGroup> VisibleGroups()
    {
        var groups = new List<VisibleShowcaseGroup>();
        VisibleShowcaseGroup? current = null;
        foreach (var root in Roots)
        {
            if (!IsVisible(root)) continue;
            if (current is null || !string.Equals(current.Category, root.Category, StringComparison.Ordinal))
            {
                current = new VisibleShowcaseGroup(root.Category, []);
                groups.Add(current);
            }
            current.Rows.Add(new VisibleShowcaseRow(root, null));
            if (!ChildrenOf.TryGetValue(root.Path, out var children)) continue;
            foreach (var child in children)
                if (IsVisible(child)) current.Rows.Add(new VisibleShowcaseRow(child, "sc-menu-child"));
        }
        return groups;
    }

    private sealed record VisibleShowcaseGroup(string Category, List<VisibleShowcaseRow> Rows);
    private sealed record VisibleShowcaseRow(ShowcaseLink Link, string? CssClass);

    private static bool Matches(ShowcaseLink l, string q)
    {
        var f = Fold(q);
        if (Fold(l.Title).Contains(f) || Fold(l.Category).Contains(f)) return true;
        foreach (var a in ShowcaseCatalog.AliasesOf(l.Path))
            if (Fold(a).Contains(f)) return true;
        return false;
    }

    // lowercase + strip accents so "visao" matches "Visão", "botao" matches "Botões".
    private static string Fold(string s)
    {
        var d = s.Normalize(System.Text.NormalizationForm.FormD);
        var sb = new System.Text.StringBuilder(d.Length);
        foreach (var c in d)
            if (System.Globalization.CharUnicodeInfo.GetUnicodeCategory(c) != System.Globalization.UnicodeCategory.NonSpacingMark)
                sb.Append(char.ToLowerInvariant(c));
        return sb.ToString();
    }

    private sealed class ShowcaseNavigationAction(NavigationManager navigation, string href)
    {
        public Task ExecuteAsync()
        {
            navigation.NavigateTo(href);
            return Task.CompletedTask;
        }
    }
}
