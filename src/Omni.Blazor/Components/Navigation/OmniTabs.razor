@namespace Omni.Blazor.Components
@inherits OmniComponentWithChildren
@using Omni.Blazor.Utilities

@* Tab container: renders a tab bar from its OmniTabItem children and shows the active tab's body. Uncontrolled by default (first registered tab active); pass ActiveIndex or @bind-ActiveIndex to drive or observe the active tab from outside. *@
<CascadingValue Value="this" IsFixed="true">
    <div class="@RootCss" style="@Style" @attributes="Attributes">
        <div class="omni-tabs-bar" role="tablist">
            @foreach (var tab in _tabs)
            {
                var current = tab;
                var active = current == _active;
                <button @key="current"
                        type="button"
                        class="@TabCss(active)"
                        id="@TabId(current)"
                        role="tab"
                        aria-selected="@(active ? "true" : "false")"
                        aria-controls="@PanelId(current)"
                        @onclick="@(() => ActivateAsync(current))">
                    @if (!string.IsNullOrEmpty(current.Icon)) { <OmniIcon Name="@current.Icon" Size="ComponentSize.Sm" /> }
                    <span>@current.Title</span>
                </button>
            }
        </div>
        <div class="omni-tabs-body"
             role="tabpanel"
             id="@(_active is null ? null : PanelId(_active))"
             aria-labelledby="@(_active is null ? null : TabId(_active))">
            @ChildContent
            @_active?.ChildContent
        </div>
    </div>
</CascadingValue>

@code {
    /// <summary>Zero-based index of the active tab. Two-way bindable via <c>@bind-ActiveIndex</c>.
    /// Default <c>-1</c> — uncontrolled: the first registered tab becomes active, unchanged from
    /// before this parameter existed.</summary>
    [Parameter] public int ActiveIndex { get; set; } = -1;

    /// <summary>Raised when the active tab changes (click or a controlled <see cref="ActiveIndex"/>
    /// update), carrying the new zero-based index.</summary>
    [Parameter] public EventCallback<int> ActiveIndexChanged { get; set; }

    private readonly List<OmniTabItem> _tabs = new();
    private OmniTabItem? _active;

    private string RootCss => CssBuilder.Default("omni-tabs")
        .AddClass(Class)
        .Build();

    private static string TabCss(bool active) => CssBuilder.Default("omni-tab")
        .AddClass("omni-active", active)
        .Build();

    private static string TabId(OmniTabItem tab) => $"{tab.Id}-tab";

    private static string PanelId(OmniTabItem tab) => $"{tab.Id}-panel";

    protected override void OnParametersSet()
    {
        if (ActiveIndex >= 0 && ActiveIndex < _tabs.Count)
        {
            _active = _tabs[ActiveIndex];
        }
    }

    internal void Register(OmniTabItem tab)
    {
        if (_tabs.Contains(tab)) return;
        _tabs.Add(tab);
        if (ActiveIndex >= 0 && ActiveIndex < _tabs.Count)
        {
            _active = _tabs[ActiveIndex];
        }
        else
        {
            _active ??= tab;
        }
        StateHasChanged();
    }

    internal void Unregister(OmniTabItem tab)
    {
        _tabs.Remove(tab);
        if (_active == tab) _active = _tabs.FirstOrDefault();
        StateHasChanged();
    }

    internal bool IsActive(OmniTabItem tab) => _active == tab;

    private async Task ActivateAsync(OmniTabItem tab)
    {
        _active = tab;
        StateHasChanged();
        if (ActiveIndexChanged.HasDelegate) await ActiveIndexChanged.InvokeAsync(_tabs.IndexOf(tab));
    }
}
