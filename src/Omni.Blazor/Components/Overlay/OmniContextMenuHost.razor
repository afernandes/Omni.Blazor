@namespace Omni.Blazor.Components
@inherits OmniComponent
@inject ContextMenuService Menu
@inject ContextMenuInteropService Interop
@implements IAsyncDisposable

@* Portal host for pointer or trigger-anchored menus with keyboard navigation and deterministic listener cleanup. *@

@if (Menu.IsOpen)
{
    <div @ref="_root"
         id="@Menu.Id"
         class="omni-context-menu"
         style="visibility:hidden; left:0; top:0;"
         @oncontextmenu:preventDefault>
        <OmniMenu>
            @{ string? previousGroup = null; }
            @foreach (ContextMenuItem item in Menu.Items)
            {
                if (!string.Equals(previousGroup, item.Group, StringComparison.Ordinal))
                {
                    if (previousGroup is not null)
                    {
                        <OmniMenuSeparator />
                    }
                    previousGroup = item.Group;
                    if (!string.IsNullOrWhiteSpace(item.Group))
                    {
                        <div class="omni-menu-group-label" role="presentation">@item.Group</div>
                    }
                }
                if (item.IsSeparator)
                {
                    <OmniMenuSeparator />
                }
                else
                {
                    ContextMenuItem captured = item;
                    <OmniMenuItem Text="@captured.Text"
                                  Icon="@captured.Icon"
                                  Shortcut="@captured.Shortcut"
                                  Description="@captured.Description"
                                  IsDanger="captured.IsDanger"
                                  Disabled="captured.Disabled"
                                  OnClick="@(async _ => await ActivateAsync(captured))" />
                }
            }
        </OmniMenu>
    </div>
}

@code {
    private ElementReference _root;
    private DotNetObjectReference<OmniContextMenuHost>? _self;
    private bool _wasOpen;
    private int _positionedRevision = -1;
    private int _disposeState;

    protected override void OnInitialized()
    {
        Menu.OnChange += Refresh;
        _self = DotNetObjectReference.Create(this);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Menu.IsOpen && Menu.Revision != _positionedRevision && _self is not null)
        {
            _wasOpen = true;
            _positionedRevision = Menu.Revision;
            await Interop.OpenAsync(
                Menu.Id,
                _root,
                Menu.X,
                Menu.Y,
                Menu.PositionMode,
                Menu.AlignEnd,
                _self);
        }
        else if (!Menu.IsOpen && _wasOpen)
        {
            _wasOpen = false;
            await Interop.CloseAsync(Menu.Id, Menu.RestoreFocusOnClose);
        }
    }

    [JSInvokable]
    public void OnClickOutside() => Menu.Close(restoreFocus: false);

    [JSInvokable]
    public void OnTab() => Menu.Close(restoreFocus: false);

    [JSInvokable]
    public void OnEsc() => Menu.Close(restoreFocus: true);

    private void Refresh()
    {
        if (Volatile.Read(ref _disposeState) != 0) return;
        ObserveTask(InvokeAsync(StateHasChanged), "OmniContextMenuHost.Refresh");
    }

    private async Task ActivateAsync(ContextMenuItem item)
    {
        Menu.Close(restoreFocus: true);
        if (item.OnClick is not null) await item.OnClick();
    }

    public async ValueTask DisposeAsync()
    {
        if (Interlocked.Exchange(ref _disposeState, 1) != 0) return;
        Menu.OnChange -= Refresh;
        try
        {
            await Interop.CloseAsync(Menu.Id, restoreFocus: false);
        }
        catch { /* circuit already gone */ }
        finally
        {
            Interlocked.Exchange(ref _self, null)?.Dispose();
        }
    }
}
