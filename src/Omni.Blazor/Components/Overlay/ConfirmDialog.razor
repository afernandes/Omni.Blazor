@namespace Omni.Blazor.Components
@inherits OmniComponent
@inject DialogService Dialog

@* Conteúdo interno do dialog de confirmação (mensagem + botões Cancelar/OK) aberto via
   DialogService.Confirm; retorna true/false.

   Ver a nota em AlertDialog: o layout usa classes próprias do dialog porque os
   utilitários que este markup usava (.omni-stack-16, .omni-row, .omni-row-end) não
   existem na folha de estilo. *@

<div class="omni-prompt">
    <div class="omni-prompt-message">
        @if (!string.IsNullOrEmpty(Options.Icon))
        {
            @* omni-toast-warn é seletor DESCENDENTE de omni-toast-ico. *@
            <div class="omni-toast-warn">
                <div class="omni-toast-ico"><OmniIcon Name="@Options.Icon" /></div>
            </div>
        }
        <div class="omni-prompt-text">@Message</div>
    </div>

    <div class="omni-prompt-actions">
        @* data-omni-cancel — Esc dispara este botão (cancel callback semântica) *@
        <OmniButton Text="@(Options.CancelButtonText ?? Texts.Cancel)" OnClick="OnCancel" data-omni-cancel="true" />
        @* data-omni-default — Enter dispara este botão (confirm) e ganha foco inicial *@
        <OmniButton Text="@(Options.OkButtonText ?? Texts.Confirm)" Variant="ButtonVariant.Primary" OnClick="OnOk" data-omni-default="true" />
    </div>
</div>

@code {
    /// <summary>Texto da mensagem exibida no corpo da confirmação.</summary>
    [Parameter, EditorRequired] public string Message { get; set; } = "";
    /// <summary>Opções da confirmação (textos dos botões OK/Cancelar, ícone). Default <c>new ConfirmOptions()</c>.</summary>
    [Parameter] public ConfirmOptions Options { get; set; } = new();

    private void OnOk(MouseEventArgs _)     => Dialog.Close((object)true);
    private void OnCancel(MouseEventArgs _) => Dialog.Close((object)false);
}
