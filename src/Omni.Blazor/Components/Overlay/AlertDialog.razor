@namespace Omni.Blazor.Components
@inherits OmniComponent
@inject DialogService Dialog

@* Conteúdo interno do dialog de alerta (mensagem + ícone opcional + botão OK) aberto via DialogService.Alert.

   O markup usa classes próprias do dialog em vez de utilitários genéricos: a versão
   anterior montava o layout com .omni-stack-16, .omni-row, .omni-row-gap-12 e
   .omni-row-end — nenhuma delas existe na folha de estilo. Sem elas o .omni-stack
   caía no flex-direction padrão (row), então o botão OK aparecia ao lado da
   mensagem, e o ícone empilhava sobre o texto. *@

<div class="omni-prompt">
    <div class="omni-prompt-message">
        @if (!string.IsNullOrEmpty(Options.Icon))
        {
            @* omni-toast-info é seletor DESCENDENTE de omni-toast-ico; as duas na mesma
               div nunca casavam e o ícone ficava sem a cor semântica. *@
            <div class="omni-toast-info">
                <div class="omni-toast-ico"><OmniIcon Name="@Options.Icon" /></div>
            </div>
        }
        <div class="omni-prompt-text">@Message</div>
    </div>

    <div class="omni-prompt-actions">
        @* data-omni-default — Enter dispara este botão; ganha foco inicial *@
        <OmniButton Text="@Options.OkButtonText" Variant="ButtonVariant.Primary" OnClick="OnOk" data-omni-default="true" />
    </div>
</div>

@code {
    /// <summary>Texto da mensagem exibida no corpo do alerta.</summary>
    [Parameter, EditorRequired] public string Message { get; set; } = "";
    /// <summary>Opções do alerta (texto do botão OK, ícone). Default <c>new AlertOptions()</c>.</summary>
    [Parameter] public AlertOptions Options { get; set; } = new();

    private void OnOk(MouseEventArgs _) => Dialog.Close((object)true);
}
