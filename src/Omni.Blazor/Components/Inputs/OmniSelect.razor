@namespace Omni.Blazor.Components
@typeparam TValue
@inherits FormComponent<TValue>
@implements IAsyncDisposable
@inject ClickOutsideService ClickOutside

@* Single-choice select with bounded local or cancellable server-side options. *@

<div class="@RootCss" style="@Style" data-omni-scid="@_id" @attributes="Attributes">
    <button type="button"
            id="@InputId"
            class="omni-input omni-select-trigger"
            disabled="@Disabled"
            role="combobox"
            aria-haspopup="listbox"
            aria-controls="@($"{_id}-listbox")"
            aria-expanded="@(_open ? "true" : "false")"
            aria-busy="@_loading"
            @onclick="ToggleAsync"
            @onkeydown="OnKeyDownAsync">
        @if (SelectedText is not null)
        {
            <span class="omni-select-value">@SelectedText</span>
        }
        else
        {
            <span class="omni-select-placeholder">@Placeholder</span>
        }
    </button>

    @if (Clearable && Value is not null && !Disabled)
    {
        <button type="button"
                class="omni-input-group-ico omni-input-group-ico-right omni-input-clear"
                tabindex="-1"
                aria-label="@Texts.Clear"
                @onclick="ClearAsync"
                @onclick:stopPropagation>
            <OmniIcon Name="x" Size="ComponentSize.Sm" />
        </button>
    }
    else
    {
        <span class="omni-input-group-ico omni-input-group-ico-right omni-select-caret">
            <OmniIcon Name="chevron-down" Size="ComponentSize.Sm" />
        </span>
    }

    @if (_open)
    {
        <div id="@($"{_id}-listbox")"
             class="omni-select-panel"
             role="listbox"
             @onclick:stopPropagation>
            @if (_providerError is not null)
            {
                @if (ErrorTemplate is not null)
                {
                    @ErrorTemplate(new OmniItemsProviderErrorContext(_providerError, RetryProviderAsync))
                }
                else
                {
                    <div class="omni-select-status" role="alert">
                        <span>@LoadErrorText</span>
                        <button type="button" @onclick="RetryProviderAsync">@RetryText</button>
                    </div>
                }
            }
            else if (_loading && _items.Count == 0)
            {
                @if (LoadingTemplate is not null)
                {
                    @LoadingTemplate
                }
                else
                {
                    <div class="omni-select-status" role="status">
                        <OmniSpinner Size="ComponentSize.Sm" />
                        <span>@LoadingText</span>
                    </div>
                }
            }
            else if (_items.Count == 0)
            {
                @if (EmptyTemplate is not null)
                {
                    @EmptyTemplate
                }
                else
                {
                    <div class="omni-select-status">@EmptyText</div>
                }
            }
            else
            {
                @for (var index = 0; index < _items.Count; index++)
                {
                    var item = _items[index];
                    var value = ValueSelector is not null ? ValueSelector(item) : item;
                    var selected = EqualityComparer<TValue>.Default.Equals(Value, value);
                    var active = index == _highlightedIndex;
                    <button @key="item"
                            type="button"
                            role="option"
                            aria-selected="@(selected ? "true" : "false")"
                            class="@OptionCss(active, selected)"
                            @onclick="@(_ => SelectAsync(value))">
                        <span class="omni-select-option-text">@TextOf(item)</span>
                        @if (selected) { <OmniIcon Name="check" Size="ComponentSize.Sm" /> }
                    </button>
                }

                @if (_loading)
                {
                    <div class="omni-select-status" role="status">
                        <OmniSpinner Size="ComponentSize.Sm" />
                        <span>@LoadingText</span>
                    </div>
                }
                else if (CanLoadMore)
                {
                    <button type="button" class="omni-select-load-more" @onclick="LoadMoreAsync">
                        @LoadMoreText
                    </button>
                }
            }
        </div>
    }
</div>
