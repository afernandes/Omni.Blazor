@namespace Omni.Blazor.Components
@typeparam TItem
@inherits FormComponent<TItem>
@implements IAsyncDisposable
@inject ClickOutsideService ClickOutside

@* Search-as-you-type selection with bounded local or cancellable server-side data. *@

<div class="@RootCss" style="@Style" data-omni-acid="@_id" @attributes="Attributes">
    <input id="@InputId"
           class="omni-input omni-autocomplete-input"
           type="text"
           value="@_searchText"
           placeholder="@Placeholder"
           disabled="@Disabled"
           readonly="@ReadOnly"
           name="@Name"
           autocomplete="off"
           role="combobox"
           aria-autocomplete="list"
           aria-controls="@($"{_id}-listbox")"
           aria-expanded="@(_open ? "true" : "false")"
           aria-busy="@_loading"
           @oninput="OnInputAsync"
           @onfocus="@(_ => OpenAsync())"
           @onkeydown="OnKeyDownAsync" />
    @if (Clearable && Value is not null && !Disabled && !ReadOnly)
    {
        <button type="button"
                class="omni-input-group-ico omni-input-group-ico-right omni-input-clear"
                tabindex="-1"
                aria-label="@Texts.Clear"
                @onclick="ClearAsync">
            <OmniIcon Name="x" Size="ComponentSize.Sm" />
        </button>
    }
    else
    {
        <span class="omni-input-group-ico omni-input-group-ico-right">
            <OmniIcon Name="chevron-down" Size="ComponentSize.Sm" />
        </span>
    }

    @if (_open)
    {
        <div id="@($"{_id}-listbox")"
             class="omni-autocomplete-panel"
             role="listbox"
             @onclick:stopPropagation>
            @if (_providerError is not null)
            {
                <div class="omni-autocomplete-status" role="alert">
                    <span>@LoadErrorText</span>
                    <button type="button" @onclick="RetryProviderAsync">@RetryText</button>
                </div>
            }
            else if (_loading && _filtered.Count == 0)
            {
                <div class="omni-autocomplete-status" role="status">
                    <OmniSpinner Size="ComponentSize.Sm" />
                    <span>@LoadingText</span>
                </div>
            }
            else if (_filtered.Count == 0)
            {
                <div class="omni-autocomplete-status">@EmptyText</div>
            }
            else
            {
                @for (var index = 0; index < _filtered.Count; index++)
                {
                    var item = _filtered[index];
                    var active = index == _highlightedIndex;
                    var selected = EqualityComparer<TItem>.Default.Equals(Value, item);
                    <button @key="item"
                            type="button"
                            role="option"
                            aria-selected="@(selected ? "true" : "false")"
                            class="@AutoOptionCss(active, selected)"
                            @onclick="@(_ => SelectAsync(item))">
                        @if (ItemTemplate is not null) { @ItemTemplate(item) }
                        else { @ResolveText(item) }
                        @if (selected) { <OmniIcon Name="check" Size="ComponentSize.Sm" /> }
                    </button>
                }

                @if (_loading)
                {
                    <div class="omni-autocomplete-status" role="status">
                        <OmniSpinner Size="ComponentSize.Sm" />
                        <span>@LoadingText</span>
                    </div>
                }
                else if (CanLoadMore)
                {
                    <button type="button"
                            class="omni-autocomplete-load-more"
                            @onclick="LoadMoreAsync">
                        @LoadMoreText
                    </button>
                }
            }
        </div>
    }
</div>
