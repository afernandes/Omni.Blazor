@namespace Omni.Blazor.Components
@typeparam TValue
@inherits OmniComponent
@implements IOmniFormComponent
@implements IDisposable

@* Multiple selection with chips and bounded local or cancellable server-side options. *@

<div class="@RootCss" style="@Style" @attributes="Attributes">
    <OmniPopover Position="PopoverPosition.Bottom"
                 Width="@PopoverWidth"
                 Open="@_open"
                 OpenChanged="OnOpenChangedAsync"
                 ShowArrow="false"
                 Offset="4">
        <Trigger>
            <div class="@TriggerCss"
                 tabindex="@(Disabled ? -1 : 0)"
                 role="combobox"
                 aria-haspopup="listbox"
                 aria-expanded="@(_open ? "true" : "false")"
                 aria-busy="@_loading"
                 aria-disabled="@Disabled">
                <div class="omni-multiselect-chips">
                    @if (Values is null || !Values.Any())
                    {
                        <span class="omni-multiselect-placeholder">@Placeholder</span>
                    }
                    else
                    {
                        @foreach (var value in Values)
                        {
                            var label = ItemTextFor(value);
                            <span @key="value" class="omni-multiselect-chip">
                                <span>@label</span>
                                @if (!Disabled)
                                {
                                    <button type="button"
                                            class="omni-multiselect-chip-x"
                                            aria-label="@string.Format(FormattingCulture, Texts.RemoveNamedItem, label)"
                                            @onclick="@(_ => RemoveAsync(value))"
                                            @onclick:stopPropagation>
                                        <OmniIcon Name="x" Size="ComponentSize.Sm" />
                                    </button>
                                }
                            </span>
                        }
                    }
                </div>
                <span class="omni-multiselect-chevron">
                    <OmniIcon Name="chevron-down" Size="ComponentSize.Sm" />
                </span>
            </div>
        </Trigger>
        <ChildContent>
            <div class="omni-multiselect-popover">
                @if (Searchable)
                {
                    <div class="omni-multiselect-search">
                        <OmniTextBox Value="@_searchText"
                                     ValueChanged="OnSearchChangedAsync"
                                     Placeholder="@(SearchPlaceholder ?? Texts.SearchPlaceholder)"
                                     LeadingIcon="search"
                                     Class="omni-autofocus" />
                    </div>
                }

                @if (_providerError is not null)
                {
                    <div class="omni-select-status" role="alert">
                        <span>@EffectiveLoadErrorText</span>
                        <button type="button" @onclick="RetryProviderAsync">@EffectiveRetryText</button>
                    </div>
                }
                else if (_loading && _availableItems.Count == 0)
                {
                    <div class="omni-select-status" role="status">
                        <OmniSpinner Size="ComponentSize.Sm" />
                        <span>@EffectiveLoadingText</span>
                    </div>
                }
                else
                {
                    <OmniListBox TValue="TValue"
                                 Items="@FilteredItems"
                                 Multiple="true"
                                 Values="@(Values ?? Array.Empty<TValue>())"
                                 ValuesChanged="OnListChangedAsync"
                                 ValueSelector="@ValueSelector"
                                 TextSelector="@TextSelector"
                                 DescriptionSelector="@DescriptionSelector"
                                 IconSelector="@IconSelector"
                                 DisabledSelector="@DisabledSelector"
                                 MaxHeight="@PopoverMaxHeight" />

                    @if (_loading)
                    {
                        <div class="omni-select-status" role="status">
                            <OmniSpinner Size="ComponentSize.Sm" />
                            <span>@EffectiveLoadingText</span>
                        </div>
                    }
                    else if (CanLoadMore)
                    {
                        <button type="button" class="omni-select-load-more" @onclick="LoadMoreAsync">
                            @EffectiveLoadMoreText
                        </button>
                    }
                }

                @if (ShowClearAll && Values?.Any() == true)
                {
                    <div class="omni-multiselect-footer">
                        <button type="button"
                                class="omni-multiselect-clear"
                                @onclick="ClearAllAsync"
                                @onclick:stopPropagation>
                            Limpar seleção (@Values.Count())
                        </button>
                    </div>
                }
            </div>
        </ChildContent>
    </OmniPopover>
</div>
