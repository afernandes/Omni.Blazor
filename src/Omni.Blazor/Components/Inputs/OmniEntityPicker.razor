@namespace Omni.Blazor.Components
@typeparam TItem where TItem : class
@typeparam TKey where TKey : notnull
@inherits FormComponent<TKey>
@using Omni.Blazor.Models
@using Omni.Blazor.Utilities

@* Form-bound entity selector that opens a searchable local or server-side DataGrid and stores only a stable key. *@

<div @ref="Element"
     class="@RootCss"
     style="@Style"
     aria-busy="@_resolving"
     @attributes="Attributes">
    <div class="omni-entity-picker-field">
        @* role=combobox, not the implicit button: a <label for> wins the accessible name
           over element content, so once the trigger became labelable the selected entity
           stopped being announced — the field read out as "Fornecedor, button" and the
           user never heard what was in it. A combobox has a value distinct from its name,
           and that value is its text content, so the label names the field and the
           selection is announced after it. This is the APG select-only combobox. *@
        <button @ref="_triggerElement"
                id="@TriggerId"
                type="button"
                role="combobox"
                class="@TriggerCss"
                disabled="@(Disabled || ReadOnly)"
                aria-haspopup="dialog"
                aria-expanded="@(_open ? "true" : "false")"
                aria-controls="@(_open ? PanelId : null)"
                aria-invalid="@IsInvalid"
                aria-describedby="@(_resolveError is not null ? ErrorId : null)"
                @onclick="OpenAsync"
                @onkeydown="OnTriggerKeyDownAsync">
            <span class="@DisplayCss">@DisplayText</span>
        </button>
        @* Adornments sit over the trigger rather than inside it: a button cannot
           nest a button, which is why the clear used to be stranded outside the
           field altogether. *@
        <span class="omni-entity-picker-adornments">
            @if (AllowClear && HasSelection)
            {
                <button type="button"
                        class="omni-entity-picker-clear"
                        disabled="@(Disabled || ReadOnly)"
                        aria-label="@(ClearText ?? Texts.Clear)"
                        title="@(ClearText ?? Texts.Clear)"
                        @onclick="@(_ => ClearAsync())">
                    <OmniIcon Name="x" Size="ComponentSize.Sm" />
                </button>
            }
            @if (_resolving)
            {
                <OmniSpinner Size="ComponentSize.Sm" />
            }
            else
            {
                <OmniIcon Name="search" Size="ComponentSize.Sm" Class="omni-entity-picker-search" />
            }
        </span>
    </div>
    @if (_resolveError is not null)
    {
        <div id="@ErrorId" class="omni-entity-picker-error" role="alert">@_resolveError.Message</div>
    }
</div>

@if (_open)
{
    <OmniOverlay Open="true"
                 AutoClose="false"
                 CloseOnEsc="true"
                 OnClosed="CloseAsync">
        <section id="@PanelId"
                 class="@PanelCss"
                 style="@PanelStyle"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="@TitleId">
            <header class="omni-entity-picker-header">
                <h2 id="@TitleId">@(Title ?? Texts.EntityPickerTitle)</h2>
                <OmniButton Text="@(CloseText ?? Texts.Close)"
                            Icon="x"
                            Size="ComponentSize.Sm"
                            Variant="ButtonVariant.Ghost"
                            OnClick="@(_ => CloseAsync())" />
            </header>
            <div class="omni-entity-picker-body">
                <OmniDataGrid TItem="TItem"
                              Schema="@GridSchema"
                              Data="@Items"
                              DataProvider="@DataProvider"
                              KeySelector="@GridKeySelector"
                              AllowSearch="@AllowSearch"
                              SearchCursorNavigation="@AllowSearch"
                              AutoFocusSearch="@AllowSearch"
                              SearchPlaceholder="@(SearchPlaceholder ?? Texts.SearchPlaceholder)"
                              AllowPaging="@AllowPaging"
                              PageSize="@PageSize"
                              EmptyText="@(EmptyText ?? Texts.NoRecords)"
                              LoadingTemplate="@LoadingTemplate"
                              OnRowClick="@SelectAsync">
                    <Columns>
                        @if (Columns is not null)
                        {
                            @Columns
                        }
                        else if (GridSchema is null)
                        {
                            <OmniDataGridColumn TItem="TItem" Title="@(ColumnTitle ?? Texts.EntityPickerItem)">
                                <Template Context="item">@TextSelector(item)</Template>
                            </OmniDataGridColumn>
                        }
                    </Columns>
                </OmniDataGrid>
            </div>
        </section>
    </OmniOverlay>
}
