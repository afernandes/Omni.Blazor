@namespace Omni.Blazor.Components
@typeparam TItem
@inherits OmniComponent
@implements IDisposable
@inject FileDownloadService Downloads
@inject DataGridInteropService GridInterop
@using System.Globalization
@using Omni.Blazor.Utilities

@* Tabela de dados rica: sorting, paging, busca, filtros/agregações por coluna, agrupamento, seleção múltipla, master-detail, tree-grid, virtualização e export CSV — in-memory ou server-side via DataProvider. *@

<CascadingValue Value="this" IsFixed="true">
    <div class="@RootCss"
         style="@RootInlineStyle"
         aria-busy="@(IsHierarchyMode ? IsHierarchyLoading : _loading)"
         @attributes="Attributes">
        @if (!Embed && (ToolbarContent is not null || AllowSearch || AllowExport || AllowColumnVisibility))
        {
            <div class="omni-grid-toolbar">
                @if (AllowSearch)
                {
                    <OmniTextBox Class="omni-grid-search"
                                  Placeholder="@EffSearchPlaceholder"
                                  LeadingIcon="search"
                                  Clearable="true"
                                  Value="@_search"
                                  ValueChanged="OnSearchChangedAsync" />
                }
                @ToolbarContent
                <div style="flex:1"></div>
                @if (AllowColumnVisibility)
                {
                    <div class="omni-grid-colmenu-wrap">
                        <OmniButton Variant="ButtonVariant.Default" Size="ComponentSize.Sm" Icon="settings"
                                     OnClick="@(_ => { _colMenuOpen = !_colMenuOpen; return Task.CompletedTask; })" />
                        @if (_colMenuOpen)
                        {
                            <div class="omni-grid-colmenu" @onclick:stopPropagation>
                                <div class="omni-grid-colmenu-title">Colunas visíveis</div>
                                @foreach (var col in _columns.Where(c => c.CanHide && !string.IsNullOrEmpty(c.Title)))
                                {
                                    <label class="omni-grid-colmenu-item">
                                        <input type="checkbox"
                                               checked="@col.VisibleInternal"
                                               @onchange="@(e => ToggleColumn(col, (bool)e.Value!))" />
                                        <span>@col.Title</span>
                                    </label>
                                }
                            </div>
                        }
                    </div>
                }
                @if (AllowExport)
                {
                    <OmniButton Variant="ButtonVariant.Default" Size="ComponentSize.Sm" Icon="download"
                                 Text="Exportar" Disabled="@IsExporting" OnClick="ExportCsvAsync" />
                }
            </div>
        }

        @* Hidden column registration *@
        <div style="display:none">@Columns</div>

        @if (AllowGrouping && !IsHierarchyMode)
        {
            <div class="omni-grid-group-panel" @ondragover:preventDefault="true" @ondrop="OnGroupPanelDropAsync">
                @if (_groupLevels.Count == 0)
                {
                    <span class="omni-grid-group-panel-hint">@GroupPanelText</span>
                }
                else
                {
                    @* Um chip por NÍVEL, e não por coluna: uma coluna com hierarquia de
                       data ocupa três, e o usuário precisa poder tirar só o "Dia" sem
                       desmontar o agrupamento inteiro. Entre eles, um separador mostra
                       que a ordem é uma hierarquia, não uma lista. *@
                    @for (var i = 0; i < _groupLevels.Count; i++)
                    {
                        var indice = i;
                        var nivel = _groupLevels[i];
                        if (indice > 0)
                        {
                            <span class="omni-grid-group-sep" aria-hidden="true">
                                <OmniIcon Name="chevron-right" Size="ComponentSize.Sm" />
                            </span>
                        }
                        <span class="omni-grid-group-chip" @key="@($"{nivel.Column.Id}:{nivel.Interval}")">
                            <span class="omni-grid-group-chip-text">@GroupChipText(nivel)</span>
                            <button type="button" class="omni-grid-group-chip-x" aria-label="@Texts.RemoveGrouping"
                                    @onclick="@(() => UngroupLevelAsync(indice))">
                                <OmniIcon Name="x" Size="ComponentSize.Sm" />
                            </button>
                        </span>
                    }
                }
            </div>
        }

        <div class="omni-grid-scroller">
            @if (_loading && LoadingTemplate is null && !LoadingSkeleton)
            {
                <div class="omni-grid-loading" aria-live="polite" aria-busy="true">
                    <OmniSpinner Size="ComponentSize.Md" />
                </div>
            }
            else if (_loading && LoadingTemplate is not null)
            {
                <div class="omni-grid-loading" aria-live="polite" aria-busy="true">
                    @LoadingTemplate
                </div>
            }
            <table class="@TableCss"
                   role="@(IsHierarchyMode ? "treegrid" : null)"
                   aria-label="@(IsHierarchyMode ? HierarchyAriaLabel : null)"
                   aria-rowcount="@(IsHierarchyMode ? HierarchyRows.Count : null)">
                <colgroup>
                    @if (AllowMultiSelection) { <col style="width:36px" /> }
                    @if (DetailTemplate is not null) { <col style="width:36px" /> }
                    @{ var _ci = 0; }
                    @foreach (var c in VisibleColumns)
                    {
                        <col id="@ColUid(_ci)" style="@ColWidthStyle(c)" />
                        _ci++;
                    }
                    @if (EditMode != DataGridEditMode.None) { <col style="width:110px" /> }
                    @if (HasFillerColumn) { <col class="omni-grid-col-filler" /> }
                </colgroup>
                <thead>
                    <tr>
                        @if (AllowMultiSelection)
                        {
                            <th scope="col" aria-label="Selecionar" class="omni-grid-th-select" style="width: 36px;" @onclick:stopPropagation>
                                <OmniCheckBox Value="@AllSelectedOnPage" ValueChanged="OnHeaderSelectChangedAsync" />
                            </th>
                        }
                        @if (DetailTemplate is not null)
                        {
                            <th scope="col" aria-label="Detalhes" class="omni-grid-th-expand" style="width: 36px;"></th>
                        }
                        @{ var _hi = 0; }
                        @foreach (var c in VisibleColumns)
                        {
                            var hi = _hi;
                            <th scope="col" class="@($"{HeaderCss(c)} {CellCss(c)}")" style="@CellStyle(c)"
                                @onclick="@(e => OnHeaderClickAsync(c, e))">
                                @if (AllowGrouping && c.Groupable)
                                {
                                    <span class="omni-grid-col-drag" draggable="true" title="Arraste para agrupar"
                                          @onclick:preventDefault="true" @onclick:stopPropagation="true"
                                          @ondragstart="@(() => OnColGroupDragStart(c))"></span>
                                }
                                @c.Title
                                @if (c.Sortable && AllowSorting)
                                {
                                    <span class="omni-grid-th-sort-ico">
                                        <OmniIcon Name="@SortIcon(c)" Size="ComponentSize.Sm" />
                                    </span>
                                    var sortIdx = GetSortIndex(c);
                                    if (sortIdx is not null && _sorts.Count > 1)
                                    {
                                        <span class="omni-grid-th-sort-idx">@(sortIdx + 1)</span>
                                    }
                                }
                                @if (AllowColumnResize && c.Resizable)
                                {
                                    <span class="omni-grid-resizer" title="Redimensionar coluna"
                                          @onclick:preventDefault="true" @onclick:stopPropagation="true"
                                          @onmousedown:preventDefault="true" @onmousedown:stopPropagation="true"
                                          @onmousedown="@(e => StartColumnResizeAsync(hi, e))"></span>
                                }
                            </th>
                            _hi++;
                        }
                        @if (EditMode != DataGridEditMode.None)
                        {
                            <th scope="col" aria-label="@Texts.Actions" style="width: 110px;"></th>
                        }
                        @if (HasFillerColumn)
                        {
                            <th class="omni-grid-th-filler" aria-hidden="true"></th>
                        }
                    </tr>
                    @if (AllowColumnFilter && _columns.Any(c => c.Filterable))
                    {
                        <tr class="omni-grid-filter-row">
                            @if (AllowMultiSelection) { <td></td> }
                            @if (DetailTemplate is not null) { <td></td> }
                            @foreach (var c in VisibleColumns)
                            {
                                <td class="@($"omni-grid-filter-cell {CellCss(c)}")" style="@CellStyle(c)">
                                    @if (c.Filterable)
                                    {
                                        var filter = _filters.TryGetValue(c, out var f) ? f : null;
                                        <OmniTextBox Value="@(filter?.Value as string)"
                                                      ValueChanged="@(v => OnFilterTextChangedAsync(c, v))"
                                                      Placeholder="Filtrar..."
                                                      Clearable="true"
                                                      Class="omni-grid-filter-input" />
                                    }
                                </td>
                            }
                            @if (EditMode != DataGridEditMode.None)
                            {
                                <td></td>
                            }
                            @if (HasFillerColumn) { <td class="omni-grid-td-filler"></td> }
                        </tr>
                    }
                </thead>
                <tbody>
                    @{
                        var anchorCol = HierarchyAnchorColumn;
                        var totalRows = IsHierarchyMode ? HierarchyRows.Count : _view.Count;
                    }
                    @if (_loading && LoadingSkeleton && LoadingTemplate is null)
                    {
                        @RenderLoadingSkeleton
                    }
                    else if (totalRows == 0 && !_loading)
                    {
                        <tr><td colspan="@FullColSpan" class="omni-grid-empty">
                            @if (EmptyTemplate is not null) { @EmptyTemplate }
                            else { @EffEmptyText }
                        </td></tr>
                    }
                    else if (IsHierarchyMode)
                    {
                        @if (Virtualize)
                        {
                            <OmniVirtualize TItem="HierarchyRow<TItem>" Items="@HierarchyRowsCollection" SpacerElement="tr"
                                             ItemSize="@RowHeight" OverscanCount="@OverscanCount">
                                <ItemContent Context="treeRow">
                                    @RenderTreeRowFragment(treeRow)
                                </ItemContent>
                            </OmniVirtualize>
                        }
                        else
                        {
                            foreach (var treeRow in HierarchyRows)
                            {
                                @RenderTreeRowFragment(treeRow)
                            }
                        }
                    }
                    else if (IsGroupMode)
                    {
                        @* A lista já vem achatada (cabeçalho, dados e rodapé numa sequência
                           linear), então os dois ramos varrem a MESMA coleção — o virtualizado
                           recorta o viewport, o outro percorre inteira. Antes daqui havia um
                           foreach recursivo sobre a árvore que ignorava Virtualize e emitia
                           todos os grupos abertos de uma vez. *@
                        @if (Virtualize)
                        {
                            <OmniVirtualize TItem="GroupRow" Items="@_flatGroupRows" SpacerElement="tr"
                                             ItemSize="@RowHeight" OverscanCount="@OverscanCount">
                                <ItemContent Context="groupRow">
                                    @RenderGroupRowFragment(groupRow)
                                </ItemContent>
                            </OmniVirtualize>
                        }
                        else
                        {
                            foreach (var groupRow in _flatGroupRows)
                            {
                                @RenderGroupRowFragment(groupRow)
                            }
                        }
                    }
                    else
                    {
                        @if (Virtualize)
                        {
                            <OmniVirtualize TItem="TItem" Items="@_view" SpacerElement="tr"
                                             ItemSize="@RowHeight" OverscanCount="@OverscanCount">
                                <ItemContent Context="row">
                                    @RenderFlatRowFragment(row)
                                </ItemContent>
                            </OmniVirtualize>
                        }
                        else
                        {
                            foreach (var row in _view)
                            {
                                @RenderFlatRowFragment(row)
                            }
                        }
                    }
                </tbody>
                @if (ShowAggregateRow && _columns.Any(c => c.Aggregate.HasValue))
                {
                    <tfoot>
                        <tr class="omni-grid-aggregate-row">
                            @if (AllowMultiSelection) { <td></td> }
                            @if (DetailTemplate is not null) { <td></td> }
                            @foreach (var c in VisibleColumns)
                            {
                                <td class="@CellCss(c)" style="@CellStyle(c)">
                                    @if (c.Aggregate.HasValue)
                                    {
                                        var v = GetAggregateForColumn(c);
                                        <span class="omni-grid-aggregate-label">@AggregateLabel(c.Aggregate!.Value)</span>
                                        <span class="omni-grid-aggregate-value">@FormatAggregate(c, v)</span>
                                    }
                                </td>
                            }
                            @if (EditMode != DataGridEditMode.None)
                            {
                                <td></td>
                            }
                            @if (HasFillerColumn) { <td class="omni-grid-td-filler"></td> }
                        </tr>
                    </tfoot>
                }
            </table>
        </div>

        @if (IsHierarchyMode && HierarchyLimitReached)
        {
            <div class="omni-tree-grid-limit" role="status">
                @string.Format(HierarchyLimitReachedText, MaxVisibleRows)
            </div>
        }

        @if (IsGroupMode && _groupLimitReached)
        {
            <div class="omni-grid-group-limit" role="status">
                @string.Format(GroupLimitReachedText, MaxGroups)
            </div>
        }

        @if (EffectivePaging && _totalCount > PageSize)
        {
            <div class="omni-grid-footer">
                @* No modo agrupado a paginação recorta grupos, não linhas — dizer só
                   "1–10 de 37" faria o usuário ler 37 registros onde há 37 grupos. *@
                <span>@_pageStart–@_pageEnd de @_totalCount @(IsGroupMode && _allGroups is not null ? Texts.Groups : null)</span>
                <div class="omni-grid-pager">
                    <OmniButton Variant="ButtonVariant.Ghost" Size="ComponentSize.Sm" IconOnly Icon="chevron-left"
                                 Disabled="@(_page == 0)"
                                 OnClick="OnPrevPageAsync" />
                    <span style="padding: 0 8px;">@(_page + 1) / @TotalPages</span>
                    <OmniButton Variant="ButtonVariant.Ghost" Size="ComponentSize.Sm" IconOnly Icon="chevron-right"
                                 Disabled="@(_page >= TotalPages - 1)"
                                 OnClick="OnNextPageAsync" />
                </div>
            </div>
        }
    </div>
</CascadingValue>

@code {
    // ——— Data source ————————————————————————————————————————————————————
    /// <summary>Fonte de dados in-memory. Ignorado se <see cref="DataProvider"/> for setado.</summary>
    [Parameter] public IEnumerable<TItem>? Data { get; set; }

    /// <summary>
    /// Callback server-side. Quando setado, o DataGrid delega filter/sort/page
    /// ao consumidor. O retorno é a janela de items a renderizar + total count.
    /// </summary>
    [Parameter] public GridDataProvider<TItem>? DataProvider { get; set; }

    /// <summary>Override do total quando server-side (caso o consumidor não preencha <c>TotalCount</c> no resultado).</summary>
    [Parameter] public int? Count { get; set; }

    /// <summary>Debounce (ms) entre keystrokes na busca antes de chamar <c>DataProvider</c>.</summary>
    [Parameter] public int DebounceMs { get; set; } = 300;

    /// <summary>Definição das colunas (<c>&lt;OmniDataGridColumn&gt;</c>). Registradas via cascading.</summary>
    [Parameter] public RenderFragment? Columns { get; set; }

    /// <summary>Conteúdo extra na toolbar (entre a busca e os botões à direita).</summary>
    [Parameter] public RenderFragment? ToolbarContent { get; set; }

    /// <summary>Mostra o campo de busca textual na toolbar. Default false.</summary>
    [Parameter] public bool AllowSearch { get; set; }

    /// <summary>Permite ordenar clicando no header das colunas <c>Sortable</c>. Default true.</summary>
    [Parameter] public bool AllowSorting { get; set; } = true;

    /// <summary>Liga a paginação no rodapé. Default true. Ignorado quando <see cref="Virtualize"/> está ativo.</summary>
    [Parameter] public bool AllowPaging { get; set; } = true;

    /// <summary>Quantidade de linhas por página. Default 10.</summary>
    [Parameter] public int PageSize { get; set; } = 10;

    /// <summary>Placeholder do campo de busca. Default <c>"Buscar..."</c>.</summary>
    [Parameter] public string? SearchPlaceholder { get; set; }
    private string EffSearchPlaceholder => SearchPlaceholder ?? Texts.SearchPlaceholder;

    /// <summary>Texto exibido quando não há registros. Default <c>"Nenhum registro encontrado."</c>.</summary>
    [Parameter] public string? EmptyText { get; set; }
    private string EffEmptyText => EmptyText ?? Texts.NoRecords;

    /// <summary>Emitido quando uma linha é clicada (fora do modo edição).</summary>
    [Parameter] public EventCallback<TItem> OnRowClick { get; set; }

    /// <summary>
    /// When true, renders without outer border/radius and stretches to fill its
    /// parent (flex:1 + min-height:0). Internal toolbar is hidden — render your
    /// own <c>OmniPaneHeader</c>/<c>OmniPaneToolbar</c> above.
    /// </summary>
    [Parameter] public bool Embed { get; set; }

    /// <summary>Enables inline editing. Each column needs an EditTemplate to be editable.</summary>
    [Parameter] public DataGridEditMode EditMode { get; set; } = DataGridEditMode.None;

    /// <summary>Fired when the user confirms an inline edit (clicks check). Use to persist changes.</summary>
    [Parameter] public EventCallback<TItem> RowUpdated { get; set; }

    /// <summary>Shows an export action that streams the filtered dataset as a bounded CSV.</summary>
    [Parameter] public bool AllowExport { get; set; }

    /// <summary>Nome do arquivo gerado pelo export CSV. Default <c>"export.csv"</c>.</summary>
    [Parameter] public string ExportFilename { get; set; } = "export.csv";

    /// <summary>Shows the column visibility menu in the toolbar.</summary>
    [Parameter] public bool AllowColumnVisibility { get; set; }

    /// <summary>Lets the user resize columns by dragging the right edge of a header cell.</summary>
    [Parameter] public bool AllowColumnResize { get; set; }

    /// <summary>Fired after a column is resized (drag of the header handle finished).</summary>
    [Parameter] public EventCallback<DataGridColumnResizedEventArgs> ColumnResized { get; set; }

    /// <summary>
    /// Enables row grouping. Shows a drop panel above the grid; drag a column's
    /// grip there (column must be <c>Groupable</c>) — or call <see cref="GroupByAsync"/> —
    /// to group rows by that column. Multiple columns nest.
    /// </summary>
    [Parameter] public bool AllowGrouping { get; set; }

    /// <summary>Hides a column from the table once it is used as a grouping key (its value shows in the group header instead).</summary>
    [Parameter] public bool HideGroupedColumn { get; set; }

    /// <summary>Renders a per-group aggregate footer row (reuses each column's <c>Aggregate</c>). Requires aggregated columns.</summary>
    [Parameter] public bool ShowGroupFooters { get; set; }

    /// <summary>Placeholder text shown in the (empty) group panel.</summary>
    [Parameter] public string GroupPanelText { get; set; } = "Arraste o cabeçalho de uma coluna aqui para agrupar";

    /// <summary>
    /// Teto de nós de grupo montados numa passada (todos os níveis somados). Default 10.000.
    /// Agrupar por uma coluna quase-única — um id, um timestamp com segundos — renderia um
    /// grupo por linha, e a árvore de grupos passaria a custar mais que os próprios dados.
    /// Ao estourar, a árvore é cortada e a UI avisa, no mesmo desenho do
    /// <see cref="MaxVisibleRows"/> da hierarquia. Valores &lt;= 0 são tratados como 1.
    /// </summary>
    [Parameter] public int MaxGroups { get; set; } = 10_000;

    /// <summary>Aviso exibido quando <see cref="MaxGroups"/> é atingido; <c>{0}</c> é o teto.</summary>
    [Parameter] public string GroupLimitReachedText { get; set; } = "Exibindo no máximo {0} grupos.";

    /// <summary>
    /// Acima de quantos grupos de primeiro nível o agrupamento nasce COLAPSADO. Default 100.
    /// Sem isso, o primeiro render depois de arrastar uma coluna é sempre o conjunto inteiro
    /// aberto — agrupar 200 mil linhas por dia significa achatar as 200 mil de uma vez só para
    /// o usuário fechar tudo em seguida. Valores &lt;= 0 desligam o auto-colapso.
    /// </summary>
    [Parameter] public int AutoCollapseGroupsThreshold { get; set; } = 100;

    /// <summary>Fired whenever the grouping changes; carries the ordered grouped property names.</summary>
    [Parameter] public EventCallback<IReadOnlyList<string>> Grouped { get; set; }

    /// <summary>
    /// Renderiza uma linha de agregação (<c>&lt;tfoot&gt;</c>) somando/contando/etc.
    /// colunas que definam <see cref="OmniDataGridColumn{TItem}.Aggregate"/>.
    /// Em modo server-side, valores vêm de <see cref="GridLoadResult{TItem}.Aggregates"/>;
    /// client-side, calculados sobre o dataset filtrado completo (não só a página atual).
    /// </summary>
    [Parameter] public bool ShowAggregateRow { get; set; }

    /// <summary>
    /// Habilita uma linha de filtros por coluna abaixo do header. Só colunas com
    /// <see cref="OmniDataGridColumn{TItem}.Filterable"/> exibem o input.
    /// </summary>
    [Parameter] public bool AllowColumnFilter { get; set; }

    // ——— Multi-selection ———————————————————————————————————————————————
    /// <summary>Habilita uma coluna de checkbox à esquerda para seleção múltipla.</summary>
    [Parameter] public bool AllowMultiSelection { get; set; }

    /// <summary>Itens selecionados. Quando setado pelo consumidor (via <c>@bind-SelectedItems</c>), o DataGrid usa essa referência diretamente.</summary>
    [Parameter] public HashSet<TItem>? SelectedItems { get; set; }

    /// <summary>Emitido quando a seleção muda. O argumento é o set atual.</summary>
    [Parameter] public EventCallback<HashSet<TItem>> SelectedItemsChanged { get; set; }

    // ——— Row expand (master-detail) ————————————————————————————————————
    /// <summary>Template renderizado abaixo da linha quando ela está expandida.</summary>
    [Parameter] public RenderFragment<TItem>? DetailTemplate { get; set; }

    /// <summary>Single = apenas uma linha expandida por vez; Multi = quantas o usuário quiser.</summary>
    [Parameter] public ExpandMode ExpandMode { get; set; } = ExpandMode.Single;

    /// <summary>Emitido quando uma linha é expandida.</summary>
    [Parameter] public EventCallback<TItem> OnRowExpand { get; set; }

    /// <summary>Emitido quando uma linha é colapsada.</summary>
    [Parameter] public EventCallback<TItem> OnRowCollapse { get; set; }

    /// <summary>
    /// Função opcional que retorna classes CSS extras por linha — útil para destacar
    /// linhas específicas (ex: "linha atual", "registro com pendência"). Aplicado em
    /// conjunto com as classes internas (selecionado, edição, etc.).
    /// </summary>
    [Parameter] public Func<TItem, string?>? RowClass { get; set; }

    // ——— Empty / Loading templates ————————————————————————————————————
    /// <summary>
    /// Slot custom para o estado vazio. Substitui o <see cref="EmptyText"/> quando setado.
    /// Permite ícone + título + CTA ricos.
    /// </summary>
    [Parameter] public RenderFragment? EmptyTemplate { get; set; }

    /// <summary>
    /// Slot custom para o overlay de loading. Substitui o spinner default quando setado.
    /// </summary>
    [Parameter] public RenderFragment? LoadingTemplate { get; set; }

    /// <summary>
    /// Quando true e <see cref="LoadingTemplate"/> não está setado, renderiza linhas
    /// de <c>OmniSkeleton</c> em vez do spinner — mais elegante para listas longas.
    /// </summary>
    [Parameter] public bool LoadingSkeleton { get; set; }

    // ——— Virtualization ———————————————————————————————————————————————
    /// <summary>
    /// Liga a virtualização do <c>&lt;tbody&gt;</c>: somente as linhas visíveis
    /// (e um overscan pequeno) são montadas no DOM. **Ignora <see cref="AllowPaging"/>**
    /// — paging e virtualize são mutuamente exclusivos. Requer <see cref="Height"/>
    /// definido (default <c>520px</c>). Implementação via <c>OmniVirtualize</c>
    /// com <c>SpacerElement="tr"</c>.
    /// </summary>
    [Parameter] public bool Virtualize { get; set; }

    /// <summary>Altura fixa (px) por linha quando virtualize ativo. Default 44.</summary>
    [Parameter] public float RowHeight { get; set; } = 44;

    /// <summary>Linhas extras renderizadas fora do viewport. Default 4.</summary>
    [Parameter] public int OverscanCount { get; set; } = 4;

    /// <summary>
    /// Altura do scroller. Obrigatória quando virtualize ativo (default <c>520px</c>
    /// é aplicado automaticamente se não setado).
    /// </summary>
    [Parameter] public string? Height { get; set; }

    private readonly List<OmniDataGridColumn<TItem>> _columns = new();
    private List<TItem> _view = new();
    // Multi-column sort: ordem importa, primeiro = critério primário
    private readonly List<(OmniDataGridColumn<TItem> Col, SortDirection Dir)> _sorts = new();
    private string? _search;
    private int _page;
    private int _totalCount;
    private int _pageStart;
    private int _pageEnd;
    private TItem? _editingRow;
    private bool _colMenuOpen;
    private bool _loading;
    private CancellationTokenSource? _searchDebounceCts;
    private CancellationTokenSource? _loadCts;
    private int _loadSeq;
    private int _disposeState;
    private IReadOnlyDictionary<string, object?>? _serverAggregates;
    private readonly Dictionary<OmniDataGridColumn<TItem>, FilterDescriptor> _filters = new();
    private readonly HashSet<TItem> _selectedInternal = new();
    private readonly HashSet<TItem> _expanded = new();

    private HashSet<TItem> Selection => SelectedItems ?? _selectedInternal;

    // Grouping state. A lista é de NÍVEIS, e não de colunas: uma coluna com
    // GroupHierarchy entra com um nível por intervalo, e cada nível é removível
    // separadamente — tirar o "Dia" de Ano › Mês › Dia não deve desfazer o resto.
    private readonly List<GroupLevelSpec> _groupLevels = new();
    private List<GroupNode> _groups = new();

    // Todos os grupos de primeiro nível do conjunto filtrado (in-memory). Null em modo
    // server-side, onde só a janela devolvida pelo DataProvider está disponível.
    private List<GroupNode>? _allGroups;
    private readonly HashSet<string> _collapsedGroups = new();
    private OmniDataGridColumn<TItem>? _draggingGroupCol;

    // A árvore de grupos reserializada como lista linear — é ELA que o <tbody> percorre.
    // Nunca troque a instância: o Clear() preserva o array de apoio, e recriar a lista a
    // cada expandir/colapsar mandaria megabytes para a LOH num conjunto grande (mesmo
    // motivo do _rows.Clear() em HierarchyState.RebuildRows).
    private readonly List<GroupRow> _flatGroupRows = new();
    private int _groupBudget;
    private bool _groupLimitReached;

    // Auto-colapso é decisão de UMA passada — a de logo depois que o agrupamento muda.
    // Reavaliar a cada BuildGroups fecharia de volta tudo que o usuário acabou de abrir.
    private bool _autoCollapsePending;

    // A single grouped node: all items under it, plus nested subgroups (null at
    // the deepest grouping level, where the items render as data rows).
    private sealed record GroupNode(
        OmniDataGridColumn<TItem> Column,
        object? Key,
        int Count,
        int Level,
        IReadOnlyList<TItem> Items,
        IReadOnlyList<GroupNode>? Children,
        DateGroupInterval? Interval = null,
        bool NestedInLarger = false);

    // Um nível de agrupamento. Normalmente é 1:1 com a coluna arrastada; uma coluna com
    // GroupHierarchy entra com um nível por intervalo declarado.
    private readonly record struct GroupLevelSpec(
        OmniDataGridColumn<TItem> Column,
        DateGroupInterval? Interval);

    /// <summary>O que uma entrada da lista achatada representa.</summary>
    private enum GroupRowKind { Header, Data, Footer }

    // Uma linha do modo agrupado depois do achatamento. Struct porque a lista chega a ter
    // uma entrada por linha do conjunto: como classe, 200 mil linhas seriam 200 mil objetos
    // no heap só para descrever o que já está descrito na árvore.
    private readonly record struct GroupRow(
        GroupRowKind Kind,
        GroupNode? Node,
        string Path,
        TItem? Item);

    /// <summary>True when at least one column is grouped (and not in tree mode).</summary>
    private bool IsGroupMode => _groupLevels.Count > 0 && !IsHierarchyMode;

    /// <summary>
    /// Linhas atualmente achatadas no modo agrupado (cabeçalhos + dados + rodapés dos grupos
    /// abertos). É o tamanho da lista entregue à virtualização, não a contagem no DOM.
    /// </summary>
    public int VisibleGroupRowCount => _flatGroupRows.Count;

    /// <summary>Whether the last grouping pass hit <see cref="MaxGroups"/>.</summary>
    public bool GroupLimitReached => _groupLimitReached;

    // Frozen column inline styles (recomputed when visible columns / widths change)
    private readonly Dictionary<OmniDataGridColumn<TItem>, (string Css, string Style)> _frozenStyles = new();

    private IEnumerable<OmniDataGridColumn<TItem>> VisibleColumns =>
        _columns.Where(c => c.VisibleInternal && !(HideGroupedColumn && _groupLevels.Any(l => l.Column == c)));

    private int TotalColCount =>
        VisibleColumns.Count()
        + (AllowMultiSelection ? 1 : 0)
        + (DetailTemplate is not null ? 1 : 0)
        + (EditMode != DataGridEditMode.None ? 1 : 0);

    /// <summary>
    /// When column resizing is on we append a trailing "filler" column with no
    /// width. Under <c>table-layout: fixed</c> a width-less &lt;col&gt; absorbs all
    /// leftover horizontal space, so the real columns render at their EXACT
    /// declared widths instead of being stretched to fill 100%. That removes the
    /// stretch→re-measure feedback loop that made a resize "jump" on the first
    /// pixel of drag, and keeps shrinking precise (the filler grows to take the
    /// slack instead of redistributing it across the other columns).
    /// </summary>
    private bool HasFillerColumn => AllowColumnResize;

    /// <summary>Colspan that spans every column including the resize filler.</summary>
    private int FullColSpan => TotalColCount + (HasFillerColumn ? 1 : 0);

    private bool AllSelectedOnPage => _view.Count > 0 && _view.All(it => Selection.Contains(it));

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_totalCount / (double)PageSize));

    /// <summary>Paging efetivo: desligado quando virtualize está ativo (são mutuamente exclusivos).</summary>
    private bool EffectivePaging => AllowPaging && !Virtualize;

    private string RootCss => CssBuilder.Default("omni-grid")
        .AddClass("omni-grid-embed", Embed)
        .AddClass(Class)
        .Build();

    internal void Register(OmniDataGridColumn<TItem> col)
    {
        if (!_columns.Contains(col))
        {
            _columns.Add(col);
            ObserveTask(ApplyAndRenderAsync(), "OmniDataGrid.RegisterColumn");
        }
    }
    internal void Unregister(OmniDataGridColumn<TItem> col) => _columns.Remove(col);

    /// <summary>
    /// Chamado por uma coluna cujo <c>Visible</c> mudou depois da montagem. O cabeçalho
    /// e as células são desenhados aqui, então sem este aviso o estado da coluna muda e
    /// a tabela continua exatamente como estava. Mesmo efeito de <see cref="ToggleColumn"/>,
    /// que é o caminho do menu embutido.
    /// </summary>
    internal void NotifyColumnsChanged() => StateHasChanged();

    protected override async Task OnParametersSetAsync()
    {
        await ApplyAndRenderAsync();
    }

    private async Task OnSearchChangedAsync(string? value)
    {
        _search = value;
        _page = 0;
        if (DataProvider is not null && DebounceMs > 0)
        {
            ScheduleDebouncedApply();
        }
        else
        {
            await ApplyAndRenderAsync();
        }
    }

    private void ScheduleDebouncedApply()
    {
        var next = new CancellationTokenSource();
        var previous = Interlocked.Exchange(ref _searchDebounceCts, next);
        CancelSafely(previous);
        ObserveTask(ApplyAfterDebounceAsync(next), "OmniDataGrid.SearchDebounce");
    }

    private async Task ApplyAfterDebounceAsync(CancellationTokenSource debounceCts)
    {
        var token = debounceCts.Token;
        try
        {
            await Task.Delay(DebounceMs, token);
            token.ThrowIfCancellationRequested();
            await InvokeAsync(ApplyAndRenderAsync);
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested)
        {
            // Superseded search or component disposal.
        }
        catch (ObjectDisposedException) when (Volatile.Read(ref _disposeState) != 0)
        {
            // Renderer and component lifetime ended while the debounce resumed.
        }
        catch (InvalidOperationException) when (Volatile.Read(ref _disposeState) != 0)
        {
            // Renderer and component lifetime ended while the debounce resumed.
        }
        catch (Exception exception)
        {
            try
            {
                await DispatchExceptionAsync(exception);
            }
            catch when (Volatile.Read(ref _disposeState) != 0)
            {
                // The renderer was released while reporting the original failure.
            }
        }
        finally
        {
            Interlocked.CompareExchange(ref _searchDebounceCts, null, debounceCts);
            debounceCts.Dispose();
        }
    }

    private async Task OnPrevPageAsync()
    {
        if (_page == 0) return;
        _page--;
        await ApplyAndRenderAsync();
    }

    private async Task OnNextPageAsync()
    {
        if (_page >= TotalPages - 1) return;
        _page++;
        await ApplyAndRenderAsync();
    }

    private async Task ApplyAndRenderAsync()
    {
        if (DataProvider is not null)
        {
            await ApplyServerSideAsync();
        }
        else
        {
            ApplyInMemory();
        }

        if (IsHierarchyMode)
        {
            await PrepareHierarchyAsync();
        }
        else
        {
            await DisableHierarchyAsync();
        }

        BuildGroups();
        RecomputeFrozenStyles();
        StateHasChanged();
    }

    private void ApplyInMemory()
    {
        var src = (Data ?? Enumerable.Empty<TItem>()).AsEnumerable();
        if (!string.IsNullOrWhiteSpace(_search))
        {
            var q = _search.Trim();
            src = src.Where(it => _columns.Any(c =>
                c.GetCellText(it)?.Contains(q, StringComparison.OrdinalIgnoreCase) == true));
        }
        src = ApplyColumnFilters(src);
        src = ApplyMultiSort(src);
        var list = src.ToList();

        // Agrupar é uma operação sobre o CONJUNTO, nunca sobre a janela: recortar a página
        // antes agruparia só as linhas visíveis, e o mesmo grupo ("01/01/2026") reapareceria
        // em várias páginas, cada uma com um contador parcial. Por isso a paginação, no modo
        // agrupado, recorta GRUPOS de primeiro nível — nunca linhas.
        if (IsGroupMode)
        {
            ApplyInMemoryGrouped(list);
            return;
        }

        _allGroups = null;
        _totalCount = list.Count;
        if (EffectivePaging)
        {
            _page = Math.Min(_page, Math.Max(0, TotalPages - 1));
            _view = list.Skip(_page * PageSize).Take(PageSize).ToList();
            _pageStart = _totalCount == 0 ? 0 : _page * PageSize + 1;
            _pageEnd = Math.Min(_totalCount, (_page + 1) * PageSize);
        }
        else
        {
            _view = list;
            _pageStart = list.Count == 0 ? 0 : 1;
            _pageEnd = list.Count;
        }
    }

    /// <summary>
    /// Monta a árvore de grupos sobre a lista inteira e, se a paginação estiver ligada,
    /// pagina os grupos de primeiro nível. Um grupo nunca fica partido entre páginas, e o
    /// contador do cabeçalho sempre reflete o total do grupo.
    /// </summary>
    private void ApplyInMemoryGrouped(List<TItem> list)
    {
        var groups = BuildGroupTree(list);
        _allGroups = groups;
        _totalCount = groups.Count;

        if (EffectivePaging)
        {
            _page = Math.Min(_page, Math.Max(0, TotalPages - 1));
            var pagina = groups.Skip(_page * PageSize).Take(PageSize).ToList();
            _pageStart = _totalCount == 0 ? 0 : _page * PageSize + 1;
            _pageEnd = Math.Min(_totalCount, (_page + 1) * PageSize);
            // _view alimenta a seleção "todos da página" e a contagem de linhas: são os
            // itens dos grupos exibidos, e não a lista inteira.
            _view = pagina.SelectMany(g => g.Items).ToList();
        }
        else
        {
            _pageStart = groups.Count == 0 ? 0 : 1;
            _pageEnd = groups.Count;
            _view = list;
        }
    }

    private async Task ApplyServerSideAsync()
    {
        // Cancel previous in-flight load — só o último request vale.
        var currentCts = new CancellationTokenSource();
        var previousCts = Interlocked.Exchange(ref _loadCts, currentCts);
        CancelSafely(previousCts);
        var token = currentCts.Token;
        var seq = Interlocked.Increment(ref _loadSeq);

        var sorts = _sorts
            .Where(s => s.Dir != SortDirection.None)
            .Select(s => new SortDescriptor(s.Col.ResolvedPropertyName, s.Dir))
            .ToList();

        var skip = EffectivePaging ? _page * PageSize : 0;
        var top  = EffectivePaging ? PageSize        : int.MaxValue;

        var state = new GridState<TItem>(
            Skip: skip,
            Top: top,
            Search: string.IsNullOrWhiteSpace(_search) ? null : _search!.Trim(),
            Sort: sorts,
            Filters: _filters.Values.ToList(),
            GroupBy: Array.Empty<string>());

        _loading = true;
        StateHasChanged();
        GridLoadResult<TItem>? result = null;
        try
        {
            result = await DataProvider!(state, token);
            if (token.IsCancellationRequested || seq != Volatile.Read(ref _loadSeq)) return;
        }
        catch (OperationCanceledException) { return; }
        finally
        {
            if (seq == Volatile.Read(ref _loadSeq)) _loading = false;
            Interlocked.CompareExchange(ref _loadCts, null, currentCts);
            currentCts.Dispose();
        }

        // Server-side: só existe a janela devolvida pelo provider, então não há árvore
        // completa para paginar — o agrupamento vale para a página, e quem quiser grupos
        // fechados devolve GridLoadResult.Groups já calculados no servidor.
        _allGroups = null;

        if (result is null) { _view = new(); _totalCount = 0; _serverAggregates = null; return; }
        _view = result.Items.ToList();
        _totalCount = Count ?? result.TotalCount;
        _serverAggregates = result.Aggregates;
        if (EffectivePaging)
        {
            // Don't reset _page here — server controls pagination.
            _page = Math.Min(_page, Math.Max(0, TotalPages - 1));
            _pageStart = _totalCount == 0 ? 0 : _page * PageSize + 1;
            _pageEnd = Math.Min(_totalCount, _page * PageSize + _view.Count);
        }
        else
        {
            _pageStart = _view.Count == 0 ? 0 : 1;
            _pageEnd = _view.Count;
        }
    }

    private async Task OnHeaderClickAsync(OmniDataGridColumn<TItem> c, MouseEventArgs e)
    {
        if (!AllowSorting || !c.Sortable) return;
        var existing = _sorts.FindIndex(s => s.Col == c);
        var shift = e.ShiftKey;

        if (existing >= 0)
        {
            var current = _sorts[existing].Dir;
            var next = current switch
            {
                SortDirection.Ascending => SortDirection.Descending,
                SortDirection.Descending => SortDirection.None,
                _ => SortDirection.Ascending
            };
            if (next == SortDirection.None)
            {
                _sorts.RemoveAt(existing);
            }
            else
            {
                _sorts[existing] = (c, next);
            }
            if (!shift)
            {
                // Sem Shift: mantém só esta coluna como critério único (a menos que tenha removido)
                var keep = _sorts.FirstOrDefault(s => s.Col == c);
                _sorts.Clear();
                if (keep.Col is not null) _sorts.Add(keep);
            }
        }
        else
        {
            if (!shift) _sorts.Clear();
            _sorts.Add((c, SortDirection.Ascending));
        }

        _page = 0;
        await ApplyAndRenderAsync();
    }

    private SortDirection? GetSortDir(OmniDataGridColumn<TItem> c)
    {
        var idx = _sorts.FindIndex(s => s.Col == c);
        return idx >= 0 ? _sorts[idx].Dir : null;
    }

    private int? GetSortIndex(OmniDataGridColumn<TItem> c)
    {
        var idx = _sorts.FindIndex(s => s.Col == c);
        return idx >= 0 ? idx : null;
    }

    private string HeaderCss(OmniDataGridColumn<TItem> c)
    {
        if (!AllowSorting || !c.Sortable) return "";
        var dir = GetSortDir(c);
        return dir is null ? "omni-grid-th-sort" : "omni-grid-th-sort omni-active";
    }

    private string SortIcon(OmniDataGridColumn<TItem> c)
    {
        var dir = GetSortDir(c);
        if (dir is null) return "chevron-down";
        return dir == SortDirection.Ascending ? "chevron-up" : "chevron-down";
    }

    private IEnumerable<TItem> ApplyMultiSort(IEnumerable<TItem> src)
    {
        if (!AllowSorting || _sorts.Count == 0) return src;
        IOrderedEnumerable<TItem>? ordered = null;
        for (int i = 0; i < _sorts.Count; i++)
        {
            var (col, dir) = _sorts[i];
            Func<TItem, object?> key = col.GetSortValue;
            if (i == 0)
            {
                ordered = dir == SortDirection.Ascending
                    ? src.OrderBy(key)
                    : src.OrderByDescending(key);
            }
            else
            {
                ordered = dir == SortDirection.Ascending
                    ? ordered!.ThenBy(key)
                    : ordered!.ThenByDescending(key);
            }
        }
        return ordered ?? src;
    }

    private string RowCss(TItem row, bool isEditing, bool isSelected)
    {
        var cls = "";
        if (OnRowClick.HasDelegate) cls += "omni-grid-row-clickable ";
        if (isEditing)              cls += "omni-grid-row-editing ";
        if (isSelected)             cls += "omni-grid-row-selected ";
        if (RowClass is not null)
        {
            var extra = RowClass(row);
            if (!string.IsNullOrWhiteSpace(extra)) cls += extra + " ";
        }
        return cls.Trim();
    }

    // ——— Selection ————————————————————————————————————————————————————
    private async Task OnHeaderSelectChangedAsync(bool value)
    {
        var sel = Selection;
        if (value)
        {
            foreach (var it in _view) sel.Add(it);
        }
        else
        {
            foreach (var it in _view) sel.Remove(it);
        }
        await NotifySelectionChangedAsync();
    }

    private async Task OnRowSelectChangedAsync(TItem row, bool value)
    {
        var sel = Selection;
        if (value) sel.Add(row); else sel.Remove(row);
        await NotifySelectionChangedAsync();
    }

    private async Task NotifySelectionChangedAsync()
    {
        if (SelectedItemsChanged.HasDelegate)
            await SelectedItemsChanged.InvokeAsync(Selection);
        StateHasChanged();
    }

    // ——— Frozen column offsets ————————————————————————————————————————
    private void RecomputeFrozenStyles()
    {
        _frozenStyles.Clear();
        var visibleCols = VisibleColumns.ToList();
        if (!visibleCols.Any(c => c.Frozen.HasValue)) return;

        // Prefix offset: cols especiais antes das colunas declaradas (selection + expand)
        int prefixOffset = 0;
        if (AllowMultiSelection) prefixOffset += 36;
        if (DetailTemplate is not null) prefixOffset += 36;

        // Left frozen — running offset cumulativo
        int leftOffset = prefixOffset;
        OmniDataGridColumn<TItem>? lastLeft = null;
        foreach (var c in visibleCols)
        {
            if (c.Frozen != FrozenPosition.Left) continue;
            var w = ParsePxWidth(c.Width);
            _frozenStyles[c] = (
                Css: "omni-grid-frozen omni-grid-frozen-left",
                Style: $"position: sticky; left: {leftOffset}px;"
            );
            leftOffset += w ?? 0;
            lastLeft = c;
        }
        if (lastLeft is not null)
        {
            var s = _frozenStyles[lastLeft];
            _frozenStyles[lastLeft] = (s.Css + " omni-grid-frozen-left-end", s.Style);
        }

        // Right frozen — running offset cumulativo da direita
        int rightOffset = 0;
        OmniDataGridColumn<TItem>? lastRight = null;
        for (int i = visibleCols.Count - 1; i >= 0; i--)
        {
            var c = visibleCols[i];
            if (c.Frozen != FrozenPosition.Right) continue;
            var w = ParsePxWidth(c.Width);
            _frozenStyles[c] = (
                Css: "omni-grid-frozen omni-grid-frozen-right",
                Style: $"position: sticky; right: {rightOffset}px;"
            );
            rightOffset += w ?? 0;
            lastRight = c;
        }
        if (lastRight is not null)
        {
            var s = _frozenStyles[lastRight];
            _frozenStyles[lastRight] = (s.Css + " omni-grid-frozen-right-end", s.Style);
        }
    }

    private static int? ParsePxWidth(string? w)
    {
        if (string.IsNullOrEmpty(w)) return null;
        var trimmed = w.Trim();
        if (trimmed.EndsWith("px") && int.TryParse(trimmed[..^2], out var px)) return px;
        return null;
    }

    private string CellCss(OmniDataGridColumn<TItem> c)
        => _frozenStyles.TryGetValue(c, out var s) ? s.Css : string.Empty;

    // Column widths live on the <colgroup> <col> elements (so a resize updates
    // one element, not every cell). Cells only carry frozen-column positioning.
    private string? CellStyle(OmniDataGridColumn<TItem> c)
    {
        var frozenPart = _frozenStyles.TryGetValue(c, out var s) ? s.Style : "";
        return string.IsNullOrEmpty(frozenPart) ? null : frozenPart;
    }

    private string TableCss => CssBuilder.Default("omni-grid-table")
        .AddClass("omni-grid-resizable", AllowColumnResize)
        .Build();

    private string ColUid(int visibleIndex) => $"{Id}-gcol-{visibleIndex}";

    private string? ColWidthStyle(OmniDataGridColumn<TItem> c)
        => c.EffectiveWidth is null ? null : $"width:{c.EffectiveWidth}";

    // ——— Row expand ————————————————————————————————————————————————————
    private async Task ToggleExpandAsync(TItem row)
    {
        if (_expanded.Contains(row))
        {
            _expanded.Remove(row);
            if (OnRowCollapse.HasDelegate) await OnRowCollapse.InvokeAsync(row);
        }
        else
        {
            if (ExpandMode == ExpandMode.Single) _expanded.Clear();
            _expanded.Add(row);
            if (OnRowExpand.HasDelegate) await OnRowExpand.InvokeAsync(row);
        }
        StateHasChanged();
    }

    private async Task HandleRowClick(TItem row)
    {
        if (_editingRow is not null) return;        // don't trigger row-click while editing
        if (OnRowClick.HasDelegate) await OnRowClick.InvokeAsync(row);
    }

    private void BeginEdit(TItem row) => _editingRow = row;
    private void CancelEdit() => _editingRow = default;

    private async Task SaveAsync(TItem row)
    {
        _editingRow = default;
        if (RowUpdated.HasDelegate) await RowUpdated.InvokeAsync(row);
    }

    private void ToggleColumn(OmniDataGridColumn<TItem> col, bool visible)
    {
        col.VisibleInternal = visible;
        StateHasChanged();
    }

    private List<TItem> ApplyFilterAndSort(List<TItem> rows)
    {
        IEnumerable<TItem> src = rows;
        if (!string.IsNullOrWhiteSpace(_search))
        {
            var q = _search.Trim();
            src = src.Where(it => _columns.Any(c =>
                c.GetCellText(it)?.Contains(q, StringComparison.OrdinalIgnoreCase) == true));
        }
        src = ApplyColumnFilters(src);
        src = ApplyMultiSort(src);
        return src.ToList();
    }

    // ——— Column filters ————————————————————————————————————————————————
    private async Task OnFilterTextChangedAsync(OmniDataGridColumn<TItem> col, string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            _filters.Remove(col);
        }
        else
        {
            _filters[col] = new FilterDescriptor(col.ResolvedPropertyName, FilterOperator.Contains, value);
        }
        _page = 0;
        if (DataProvider is not null && DebounceMs > 0) ScheduleDebouncedApply();
        else await ApplyAndRenderAsync();
    }

    private IEnumerable<TItem> ApplyColumnFilters(IEnumerable<TItem> src)
    {
        if (_filters.Count == 0) return src;
        foreach (var (col, filter) in _filters)
        {
            src = src.Where(it => MatchesFilter(it, col, filter));
        }
        return src;
    }

    private static bool MatchesFilter(TItem item, OmniDataGridColumn<TItem> col, FilterDescriptor f)
    {
        object? raw = col.Property is not null ? col.Property(item) : col.GetCellText(item);
        return f.Operator switch
        {
            FilterOperator.Contains       => ToText(raw).Contains(ToText(f.Value), StringComparison.OrdinalIgnoreCase),
            FilterOperator.NotContains    => !ToText(raw).Contains(ToText(f.Value), StringComparison.OrdinalIgnoreCase),
            FilterOperator.Equals         => CompareValues(raw, f.Value) == 0,
            FilterOperator.NotEquals      => CompareValues(raw, f.Value) != 0,
            FilterOperator.StartsWith     => ToText(raw).StartsWith(ToText(f.Value), StringComparison.OrdinalIgnoreCase),
            FilterOperator.EndsWith       => ToText(raw).EndsWith(ToText(f.Value), StringComparison.OrdinalIgnoreCase),
            FilterOperator.GreaterThan    => CompareValues(raw, f.Value) > 0,
            FilterOperator.GreaterOrEqual => CompareValues(raw, f.Value) >= 0,
            FilterOperator.LessThan       => CompareValues(raw, f.Value) < 0,
            FilterOperator.LessOrEqual    => CompareValues(raw, f.Value) <= 0,
            FilterOperator.Between        => CompareValues(raw, f.Value) >= 0 && CompareValues(raw, f.SecondValue) <= 0,
            FilterOperator.NotBetween     => !(CompareValues(raw, f.Value) >= 0 && CompareValues(raw, f.SecondValue) <= 0),
            FilterOperator.IsEmpty        => string.IsNullOrEmpty(ToText(raw)),
            FilterOperator.IsNotEmpty     => !string.IsNullOrEmpty(ToText(raw)),
            _ => true
        };
    }

    private static string ToText(object? v) => v?.ToString() ?? string.Empty;

    private static int CompareValues(object? a, object? b)
    {
        if (a is null && b is null) return 0;
        if (a is null) return -1;
        if (b is null) return 1;
        // Comparable same type
        if (a.GetType() == b.GetType() && a is IComparable ac)
            return ac.CompareTo(b);
        // Try numeric
        try
        {
            var da = Convert.ToDecimal(a, System.Globalization.CultureInfo.InvariantCulture);
            var db = Convert.ToDecimal(b, System.Globalization.CultureInfo.InvariantCulture);
            return da.CompareTo(db);
        }
        catch { /* fall through */ }
        // Try DateTime
        if (a is DateTime || b is DateTime)
        {
            if (DateTime.TryParse(a.ToString(), out var dta) &&
                DateTime.TryParse(b.ToString(), out var dtb))
                return dta.CompareTo(dtb);
        }
        // Fallback: string
        return string.Compare(a.ToString(), b.ToString(), StringComparison.OrdinalIgnoreCase);
    }

    // ——— Aggregations ————————————————————————————————————————————————————
    private object? GetAggregateForColumn(OmniDataGridColumn<TItem> col)
    {
        if (col.Aggregate is null) return null;

        // Server-side: usar valor pré-calculado pelo consumidor (se houver)
        if (DataProvider is not null)
        {
            if (_serverAggregates is not null &&
                _serverAggregates.TryGetValue(col.ResolvedPropertyName, out var v))
                return v;
            return null;
        }

        // Client-side: calcula sobre o dataset filtrado completo (não só a página atual)
        var src = ApplyFilterAndSort((Data ?? Enumerable.Empty<TItem>()).ToList());
        var fn = col.Aggregate.Value;
        if (fn == AggregateFunction.Count) return src.Count;

        var values = src
            .Select(col.GetAggregateValue)
            .Where(v => v.HasValue)
            .Select(v => v!.Value)
            .ToList();
        if (values.Count == 0) return null;

        return fn switch
        {
            AggregateFunction.Sum => values.Sum(),
            AggregateFunction.Average => values.Average(),
            AggregateFunction.Min => values.Min(),
            AggregateFunction.Max => values.Max(),
            _ => null
        };
    }

    // Aggregate over an explicit item list (used by per-group footers).
    private static object? ComputeAggregate(OmniDataGridColumn<TItem> col, IReadOnlyList<TItem> items)
    {
        if (col.Aggregate is null) return null;
        var fn = col.Aggregate.Value;
        if (fn == AggregateFunction.Count) return items.Count;
        var values = items.Select(col.GetAggregateValue).Where(v => v.HasValue).Select(v => v!.Value).ToList();
        if (values.Count == 0) return null;
        return fn switch
        {
            AggregateFunction.Sum => values.Sum(),
            AggregateFunction.Average => values.Average(),
            AggregateFunction.Min => values.Min(),
            AggregateFunction.Max => values.Max(),
            _ => null
        };
    }

    // ─── Grouping ─────────────────────────────────────────────────────────
    /// <summary>
    /// Publica os grupos a exibir. In-memory, a árvore já foi montada sobre o conjunto
    /// inteiro em <see cref="ApplyInMemoryGrouped"/> — aqui só se recorta a página. No modo
    /// server-side o consumidor manda a janela, então o agrupamento é sobre ela mesmo.
    /// </summary>
    private void BuildGroups()
    {
        if (!IsGroupMode)
        {
            _groups = new();
            _flatGroupRows.Clear();
            _groupLimitReached = false;
            return;
        }

        if (_allGroups is { } todos)
        {
            _groups = EffectivePaging
                ? todos.Skip(_page * PageSize).Take(PageSize).ToList()
                : todos;
        }
        else
        {
            _groups = BuildGroupTree(_view);
        }

        ApplyAutoCollapse();
        RebuildFlatGroupRows();
    }

    /// <summary>
    /// Fecha os grupos de primeiro nível quando eles passam de
    /// <see cref="AutoCollapseGroupsThreshold"/>, e só na passada imediatamente posterior à
    /// mudança de agrupamento — depois disso quem manda é o usuário.
    /// </summary>
    private void ApplyAutoCollapse()
    {
        if (!_autoCollapsePending) return;
        _autoCollapsePending = false;
        if (AutoCollapseGroupsThreshold <= 0) return;

        // Semear a partir do conjunto inteiro, e não da página: com paginação ligada,
        // _groups é só a fatia atual, e as outras páginas nasceriam abertas.
        var todos = _allGroups ?? _groups;
        if (todos.Count <= AutoCollapseGroupsThreshold) return;
        foreach (var node in todos)
        {
            _collapsedGroups.Add(GroupPath("", node));
        }
    }

    /// <summary>
    /// Reserializa a árvore de grupos numa lista linear em profundidade — cabeçalho, o que
    /// estiver aberto abaixo dele, rodapé — pulando a subárvore INTEIRA de um grupo colapsado.
    /// É esse achatamento que permite entregar o modo agrupado ao <c>OmniVirtualize</c>: a
    /// recursão anterior acontecia dentro do render e emitia todas as linhas de todos os
    /// grupos abertos num único batch (medido: 18 frames por linha, 1,8 milhão de frames a
    /// 100 mil linhas). Mesmo desenho do <c>HierarchyState.RebuildRows</c>.
    /// </summary>
    private void RebuildFlatGroupRows()
    {
        _flatGroupRows.Clear();
        if (!IsGroupMode) return;

        var comRodape = ShowGroupFooters && _columns.Any(c => c.Aggregate.HasValue);
        foreach (var node in _groups)
        {
            FlattenGroup(node, "", comRodape);
        }
    }

    private void FlattenGroup(GroupNode node, string parentPath, bool comRodape)
    {
        var path = GroupPath(parentPath, node);
        _flatGroupRows.Add(new GroupRow(GroupRowKind.Header, node, path, default));
        if (_collapsedGroups.Contains(path)) return;

        if (node.Children is not null)
        {
            foreach (var child in node.Children)
            {
                FlattenGroup(child, path, comRodape);
            }
        }
        else
        {
            foreach (var item in node.Items)
            {
                _flatGroupRows.Add(new GroupRow(GroupRowKind.Data, null, path, item));
            }
        }

        // Pós-ordem e só em grupo aberto, como no render recursivo: o rodapé do pai vem
        // DEPOIS dos rodapés dos filhos, e grupo fechado não tem rodapé nenhum.
        if (comRodape)
        {
            _flatGroupRows.Add(new GroupRow(GroupRowKind.Footer, node, path, default));
        }
    }

    /// <summary>
    /// Monta a árvore inteira com o orçamento de <see cref="MaxGroups"/> zerado. Todo
    /// caminho que reconstrói a árvore passa por aqui — é o único lugar que reseta o teto.
    /// </summary>
    private List<GroupNode> BuildGroupTree(IReadOnlyList<TItem> items)
    {
        _groupBudget = Math.Max(1, MaxGroups);
        _groupLimitReached = false;
        return BuildGroupLevel(items, 0);
    }

    /// <summary>
    /// Diz se o nível pode usar o rótulo curto ("julho" em vez de "julho 2026"): só quando
    /// o nível IMEDIATAMENTE acima é da mesma coluna e cobre a unidade maior. Calculado
    /// sobre a lista atual, e não sobre o <c>GroupHierarchy</c> declarado — remover o
    /// "Mês" de Ano › Mês › Dia deixa o dia direto sob o ano, onde "31" sozinho não
    /// identificaria mais nada.
    /// </summary>
    private bool IsNestedLevel(int level)
    {
        if (level == 0) return false;
        var atual = _groupLevels[level];
        var anterior = _groupLevels[level - 1];
        return atual.Column == anterior.Column
            && atual.Interval is { } inner
            && anterior.Interval is { } outer
            && DateGrouping.IsNestedIn(inner, outer);
    }

    private List<GroupNode> BuildGroupLevel(IReadOnlyList<TItem> items, int level)
    {
        var spec = _groupLevels[level];
        var isLeaf = level == _groupLevels.Count - 1;
        var nested = IsNestedLevel(level);
        var nodes = new List<GroupNode>();
        foreach (var g in items.GroupBy(it => GroupKeyOf(spec, it)))
        {
            // O orçamento é global à árvore, e não por nível: agrupar por uma coluna
            // quase-única estoura no primeiro nível, mas Ano › Mês › Dia estoura na soma.
            if (_groupBudget <= 0)
            {
                _groupLimitReached = true;
                break;
            }
            _groupBudget--;

            var groupItems = g.ToList();
            nodes.Add(new GroupNode(
                Column: spec.Column,
                Key: g.Key,
                Count: groupItems.Count,
                Level: level,
                Items: groupItems,
                Children: isLeaf ? null : BuildGroupLevel(groupItems, level + 1),
                Interval: spec.Interval,
                NestedInLarger: nested));
        }
        return nodes;
    }

    /// <summary>
    /// Chave do grupo: o valor da coluna, truncado até o intervalo quando o nível é de
    /// data. Truncar aqui (e não no <c>Property</c> do consumidor) é o que permite a mesma
    /// coluna alimentar célula, ordenação e vários níveis de agrupamento ao mesmo tempo.
    /// </summary>
    private static object? GroupKeyOf(GroupLevelSpec spec, TItem item)
    {
        var value = spec.Column.GetSortValue(item);
        return spec.Interval is { } interval ? DateGrouping.Truncate(value, interval) : value;
    }

    // Stable identity for a group across renders = path of keys from the root.
    private static string GroupPath(string parentPath, GroupNode node)
        => $"{parentPath}/{node.Level}:{node.Key?.ToString() ?? "∅"}";

    private string GroupKeyText(GroupNode node)
    {
        // Nível de data: o rótulo vem da CHAVE (já truncada), não da célula do primeiro
        // item — a célula mostra o instante completo, que é justamente o que o grupo
        // deixou de considerar.
        if (node.Interval is { } interval)
        {
            return node.Key is DateTime key
                ? DateGrouping.Label(key, interval, node.NestedInLarger, CultureInfo.CurrentCulture, Texts)
                : "(vazio)";
        }

        var txt = node.Items.Count > 0 ? node.Column.GetCellText(node.Items[0]) : node.Key?.ToString();
        return string.IsNullOrEmpty(txt) ? "(vazio)" : txt;
    }

    /// <summary>
    /// Nome do nível no cabeçalho do grupo. Com hierarquia de data, repetir o título da
    /// coluna em Ano, Mês e Dia é ruído — a unidade é a informação que muda.
    /// </summary>
    private string GroupTitleText(GroupNode node) =>
        node.Interval is { } interval
            ? DateGrouping.IntervalName(interval, Texts)
            : node.Column.Title ?? string.Empty;

    /// <summary>
    /// Rótulo do chip: "Data/hora (Ano)" num nível de data, ou só o título da coluna
    /// quando o agrupamento é pelo valor. A coluna vem junto porque dois campos de data
    /// agrupados dariam dois chips "Ano" indistinguíveis.
    /// </summary>
    private string GroupChipText(GroupLevelSpec level) =>
        level.Interval is { } interval
            ? $"{level.Column.Title} ({DateGrouping.IntervalName(interval, Texts)})"
            : level.Column.Title ?? string.Empty;

    private void ToggleGroup(string path)
    {
        if (!_collapsedGroups.Remove(path)) _collapsedGroups.Add(path);
        // Antes o render recursivo consultava _collapsedGroups na hora e o re-render bastava.
        // Agora quem descreve o <tbody> é a lista achatada, então ela é que precisa mudar.
        RebuildFlatGroupRows();
    }

    private async Task AddGroupColumnAsync(OmniDataGridColumn<TItem> col)
    {
        if (col is null || !col.Groupable) return;
        if (_groupLevels.Any(l => l.Column == col)) return;

        // Uma coluna com hierarquia entra com todos os seus níveis de uma vez — o arrasto
        // é um só. A partir daí cada nível vive por conta própria e pode ser removido.
        if (col.GroupHierarchy is { Count: > 0 } hierarquia)
        {
            foreach (var intervalo in hierarquia)
            {
                _groupLevels.Add(new GroupLevelSpec(col, intervalo));
            }
        }
        else
        {
            _groupLevels.Add(new GroupLevelSpec(col, null));
        }

        await OnGroupsChangedAsync();
    }

    /// <summary>Remove TODOS os níveis de uma coluna do agrupamento.</summary>
    internal async Task UngroupAsync(OmniDataGridColumn<TItem> col)
    {
        if (_groupLevels.RemoveAll(l => l.Column == col) > 0) await OnGroupsChangedAsync();
    }

    /// <summary>
    /// Remove um único nível — o "x" de um chip. Tirar "Mês" de Ano › Mês › Dia deixa
    /// Ano › Dia de pé, em vez de desfazer o agrupamento inteiro.
    /// </summary>
    private async Task UngroupLevelAsync(int index)
    {
        if (index < 0 || index >= _groupLevels.Count) return;
        _groupLevels.RemoveAt(index);
        await OnGroupsChangedAsync();
    }

    private async Task OnGroupsChangedAsync()
    {
        _collapsedGroups.Clear();
        _autoCollapsePending = true;
        await ApplyAndRenderAsync();
        if (Grouped.HasDelegate)
            // Distinct: uma coluna com hierarquia ocupa vários níveis, mas para quem
            // escuta o evento (persistência de layout, server-side) ela é uma só.
            await Grouped.InvokeAsync(
                _groupLevels.Select(l => l.Column.ResolvedPropertyName).Distinct().ToList());
    }

    /// <summary>Programmatically groups by the column with the given resolved property name.</summary>
    public Task GroupByAsync(string propertyName)
    {
        var col = _columns.FirstOrDefault(c => c.ResolvedPropertyName == propertyName);
        return col is null ? Task.CompletedTask : AddGroupColumnAsync(col);
    }

    /// <summary>Removes the given property from the grouping.</summary>
    public Task UngroupByAsync(string propertyName)
    {
        var col = _columns.FirstOrDefault(c => c.ResolvedPropertyName == propertyName);
        return col is null ? Task.CompletedTask : UngroupAsync(col);
    }

    /// <summary>Clears all grouping.</summary>
    public Task ClearGroupingAsync()
    {
        if (_groupLevels.Count == 0) return Task.CompletedTask;
        _groupLevels.Clear();
        return OnGroupsChangedAsync();
    }

    private void OnColGroupDragStart(OmniDataGridColumn<TItem> col) => _draggingGroupCol = col;

    private async Task OnGroupPanelDropAsync()
    {
        var col = _draggingGroupCol;
        _draggingGroupCol = null;
        if (col is not null) await AddGroupColumnAsync(col);
    }

    private static string AggregateLabel(AggregateFunction fn) => fn switch
    {
        AggregateFunction.Sum     => "Σ",
        AggregateFunction.Average => "x̄",
        AggregateFunction.Count   => "#",
        AggregateFunction.Min     => "min",
        AggregateFunction.Max     => "max",
        _ => "?"
    };

    private static string FormatAggregate(OmniDataGridColumn<TItem> col, object? value)
    {
        if (value is null) return "—";
        if (col.AggregateFormat is not null) return col.AggregateFormat(value);
        // CurrentCulture (not a fixed locale): the aggregate row must match how the cells
        // above it are formatted — a hardcoded culture shows the wrong decimal separator
        // in any app that isn't pt-BR.
        return value switch
        {
            decimal d => d.ToString("N2", System.Globalization.CultureInfo.CurrentCulture),
            double dbl => dbl.ToString("N2", System.Globalization.CultureInfo.CurrentCulture),
            float f => f.ToString("N2", System.Globalization.CultureInfo.CurrentCulture),
            _ => value.ToString() ?? "—"
        };
    }

    /// <summary>
    /// Inline style aplicado no root <c>.omni-grid</c>. Quando <see cref="Virtualize"/>
    /// está ativo, aplica altura fixa no root (o flex column distribui pra toolbar/scroller
    /// naturalmente). Combina com <c>Style</c> do consumidor.
    /// </summary>
    private string? RootInlineStyle
    {
        get
        {
            string? heightPart = null;
            if (Virtualize || !string.IsNullOrEmpty(Height))
            {
                var h = string.IsNullOrEmpty(Height) ? "520px" : Height;
                heightPart = $"height: {h}; max-height: {h};";
            }
            if (Virtualize)
            {
                // O Virtualize calcula a rolagem com UM ItemSize para todas as linhas, mas
                // cabeçalho (~41px) e rodapé (~33px) de grupo são mais baixos que uma linha
                // de dados. Publicar a altura como custom property é o que deixa o CSS
                // igualar os três — e só com Virtualize ligado, para o modo paginado manter
                // a altura natural que sempre teve.
                var rowHeight = RowHeight.ToString(CultureInfo.InvariantCulture);
                heightPart = $"{heightPart}--omni-grid-row-h: {rowHeight}px;";
            }
            if (string.IsNullOrEmpty(heightPart)) return Style;
            return string.IsNullOrEmpty(Style) ? heightPart : $"{Style?.TrimEnd(';')}; {heightPart}";
        }
    }

    private RenderFragment RenderTreeRowFragment(HierarchyRow<TItem> tr) => __builder =>
    {
        var row = tr.Item;
        var level = tr.Level;
        var hasChildren = tr.HasChildren;
        var isEditing = _editingRow is not null && ReferenceEquals(_editingRow, row);
        var isSelected = AllowMultiSelection && Selection.Contains(row);
        var isDetailExpanded = DetailTemplate is not null && _expanded.Contains(row);
        var anchorCol = HierarchyAnchorColumn;
        <tr @key="tr.Key"
            class="@RowCss(row, isEditing, isSelected)"
            role="row"
            aria-level="@(level + 1)"
            aria-expanded="@HierarchyExpandedAria(tr)"
            aria-selected="@HierarchySelectedAria(row)"
            tabindex="@HierarchyRowTabIndex(tr)"
            @onclick="@(() => HandleHierarchyRowClickAsync(tr))"
            @ondblclick="@(() => HandleHierarchyRowDoubleClickAsync(tr))"
            @onkeydown="@(args => HandleHierarchyKeyDownAsync(tr, args))">
            @if (AllowMultiSelection)
            {
                <td class="omni-grid-td-select" @onclick:stopPropagation>
                    <OmniCheckBox Value="isSelected" ValueChanged="@(v => OnRowSelectChangedAsync(row, v))" />
                </td>
            }
            @if (DetailTemplate is not null)
            {
                <td class="omni-grid-td-expand" @onclick:stopPropagation>
                    <button type="button"
                            class="@($"omni-grid-expand-btn {(isDetailExpanded ? "omni-active" : "")}")"
                            aria-label="@(isDetailExpanded ? "Colapsar" : "Expandir")"
                            aria-expanded="@isDetailExpanded"
                            @onclick="@(_ => ToggleExpandAsync(row))">
                        <OmniIcon Name="@(isDetailExpanded ? "chevron-down" : "chevron-right")" Size="ComponentSize.Sm" />
                    </button>
                </td>
            }
            @foreach (var c in VisibleColumns)
            {
                var isAnchor = c == anchorCol;
                <td role="gridcell" class="@CellCss(c)" style="@CellStyle(c)">
                    @if (isAnchor)
                    {
                        <div class="omni-grid-tree-anchor">
                            <span class="omni-grid-tree-indent" style="width: @(level * IndentSize)px;"></span>
                            @if (hasChildren)
                            {
                                <button type="button" class="omni-grid-tree-chevron"
                                        aria-label="@(_hierarchy.IsExpanded(tr.Key) ? CollapseText : ExpandText)"
                                        aria-expanded="@_hierarchy.IsExpanded(tr.Key)"
                                        disabled="@_hierarchy.IsNodeLoading(tr.Key)"
                                        @onclick:stopPropagation
                                        @onclick="@(_ => ToggleHierarchyItemAsync(row))">
                                    @if (_hierarchy.IsNodeLoading(tr.Key))
                                    {
                                        <OmniSpinner Size="ComponentSize.Sm" />
                                    }
                                    else
                                    {
                                        <OmniIcon Name="@(_hierarchy.IsExpanded(tr.Key) ? "chevron-down" : "chevron-right")" Size="ComponentSize.Sm" />
                                    }
                                </button>
                            }
                            else
                            {
                                <span class="omni-grid-tree-chevron-spacer"></span>
                            }
                            <span class="omni-grid-tree-content">
                                @if (isEditing && c.EditTemplate is not null) { @c.EditTemplate(row) }
                                else if (c.Template is not null) { @c.Template(row) }
                                else { @c.GetCellText(row) }
                            </span>
                        </div>
                    }
                    else
                    {
                        @if (isEditing && c.EditTemplate is not null) { @c.EditTemplate(row) }
                        else if (c.Template is not null) { @c.Template(row) }
                        else { @c.GetCellText(row) }
                    }
                </td>
            }
            @if (EditMode != DataGridEditMode.None)
            {
                <td class="omni-grid-edit-actions" @onclick:stopPropagation>
                    @if (isEditing)
                    {
                        <OmniButton Icon="check" IconOnly Variant="ButtonVariant.Primary" Size="ComponentSize.Sm"
                                     OnClick="@(_ => SaveAsync(row))" />
                        <OmniButton Icon="x" IconOnly Variant="ButtonVariant.Ghost" Size="ComponentSize.Sm"
                                     OnClick="@(_ => CancelEdit())" />
                    }
                    else
                    {
                        <OmniButton Icon="edit" IconOnly Variant="ButtonVariant.Ghost" Size="ComponentSize.Sm"
                                     OnClick="@(_ => BeginEdit(row))" />
                    }
                </td>
            }
            @if (HasFillerColumn) { <td class="omni-grid-td-filler"></td> }
        </tr>
        @if (isDetailExpanded)
        {
            <tr class="omni-grid-detail-row">
                <td colspan="@FullColSpan">
                    @DetailTemplate!(row)
                </td>
            </tr>
        }
        @if (_hierarchy.TryGetError(tr.Key, out var hierarchyError))
        {
            <tr @key="HierarchyErrorRowKey(tr.Key)" class="omni-tree-grid-error-row">
                <td colspan="@FullColSpan">
                    <span>@HierarchyLoadErrorText</span>
                    <button type="button" @onclick="@(() => RetryHierarchyAsync(row))">@HierarchyRetryText</button>
                    <span class="omni-visually-hidden">@hierarchyError</span>
                </td>
            </tr>
        }
    };

    private RenderFragment RenderFlatRowFragment(TItem row) => __builder =>
    {
        var isEditing = _editingRow is not null && ReferenceEquals(_editingRow, row);
        var isSelected = AllowMultiSelection && Selection.Contains(row);
        var isExpanded = DetailTemplate is not null && _expanded.Contains(row);
        <tr class="@RowCss(row, isEditing, isSelected)" @onclick="@(() => HandleRowClick(row))">
            @if (AllowMultiSelection)
            {
                <td class="omni-grid-td-select" @onclick:stopPropagation>
                    <OmniCheckBox Value="isSelected" ValueChanged="@(v => OnRowSelectChangedAsync(row, v))" />
                </td>
            }
            @if (DetailTemplate is not null)
            {
                <td class="omni-grid-td-expand" @onclick:stopPropagation>
                    <button type="button"
                            class="@($"omni-grid-expand-btn {(isExpanded ? "omni-active" : "")}")"
                            aria-label="@(isExpanded ? "Colapsar" : "Expandir")"
                            aria-expanded="@isExpanded"
                            @onclick="@(_ => ToggleExpandAsync(row))">
                        <OmniIcon Name="@(isExpanded ? "chevron-down" : "chevron-right")" Size="ComponentSize.Sm" />
                    </button>
                </td>
            }
            @foreach (var c in VisibleColumns)
            {
                <td class="@CellCss(c)" style="@CellStyle(c)">
                    @if (isEditing && c.EditTemplate is not null) { @c.EditTemplate(row) }
                    else if (c.Template is not null) { @c.Template(row) }
                    else { @c.GetCellText(row) }
                </td>
            }
            @if (EditMode != DataGridEditMode.None)
            {
                <td class="omni-grid-edit-actions" @onclick:stopPropagation>
                    @if (isEditing)
                    {
                        <OmniButton Icon="check" IconOnly Variant="ButtonVariant.Primary" Size="ComponentSize.Sm"
                                     OnClick="@(_ => SaveAsync(row))" />
                        <OmniButton Icon="x" IconOnly Variant="ButtonVariant.Ghost" Size="ComponentSize.Sm"
                                     OnClick="@(_ => CancelEdit())" />
                    }
                    else
                    {
                        <OmniButton Icon="edit" IconOnly Variant="ButtonVariant.Ghost" Size="ComponentSize.Sm"
                                     OnClick="@(_ => BeginEdit(row))" />
                    }
                </td>
            }
            @if (HasFillerColumn) { <td class="omni-grid-td-filler"></td> }
        </tr>
        @if (isExpanded)
        {
            <tr class="omni-grid-detail-row">
                <td colspan="@FullColSpan">
                    @DetailTemplate!(row)
                </td>
            </tr>
        }
    };

    // Despacho por tipo de linha da lista achatada. Substituiu o renderer recursivo:
    // a ordem das linhas (cabeçalho › filhos/dados › rodapé) agora está no achatamento,
    // e aqui só sobra desenhar UMA linha — que é o que a virtualização precisa.
    private RenderFragment RenderGroupRowFragment(GroupRow row) => row.Kind switch
    {
        GroupRowKind.Header => RenderGroupHeaderFragment(row.Node!, row.Path),
        GroupRowKind.Footer => RenderGroupFooterFragment(row.Node!),
        _ => RenderFlatRowFragment(row.Item!)
    };

    // Cabeçalho colapsável de um grupo.
    private RenderFragment RenderGroupHeaderFragment(GroupNode node, string path) => __builder =>
    {
        var collapsed = _collapsedGroups.Contains(path);
        var indent = node.Level * 18;
        <tr class="omni-grid-group-row" @key="path">
            <td colspan="@FullColSpan" class="omni-grid-group-cell">
                <div class="omni-grid-group-head" style="@($"padding-left:{indent + 8}px;")">
                    <button type="button" class="omni-grid-group-toggle"
                            aria-expanded="@((!collapsed).ToString().ToLowerInvariant())"
                            @onclick="@(() => ToggleGroup(path))">
                        <OmniIcon Name="@(collapsed ? "chevron-right" : "chevron-down")" Size="ComponentSize.Sm" />
                    </button>
                    <span class="omni-grid-group-title">@GroupTitleText(node)</span>
                    <span class="omni-grid-group-key">@GroupKeyText(node)</span>
                    <span class="omni-grid-group-count">@node.Count</span>
                </div>
            </td>
        </tr>
    };

    private RenderFragment RenderGroupFooterFragment(GroupNode node) => __builder =>
    {
        <tr class="omni-grid-group-footer">
            @if (AllowMultiSelection) { <td></td> }
            @if (DetailTemplate is not null) { <td></td> }
            @foreach (var c in VisibleColumns)
            {
                <td class="@CellCss(c)" style="@CellStyle(c)">
                    @if (c.Aggregate.HasValue)
                    {
                        var v = ComputeAggregate(c, node.Items);
                        <span class="omni-grid-aggregate-label">@AggregateLabel(c.Aggregate!.Value)</span>
                        <span class="omni-grid-aggregate-value">@FormatAggregate(c, v)</span>
                    }
                </td>
            }
            @if (EditMode != DataGridEditMode.None) { <td></td> }
            @if (HasFillerColumn) { <td class="omni-grid-td-filler"></td> }
        </tr>
    };

    private RenderFragment RenderLoadingSkeleton => __builder =>
    {
        var rows = Math.Max(4, Math.Min(10, EffectivePaging ? PageSize : 8));
        var visibleCols = VisibleColumns.ToList();
        for (int i = 0; i < rows; i++)
        {
            var rowIdx = i;
            <tr class="omni-grid-skeleton-row" style="@($"--row-i: {rowIdx};")">
                @if (AllowMultiSelection) { <td class="omni-grid-td-select"></td> }
                @if (DetailTemplate is not null) { <td class="omni-grid-td-expand"></td> }
                @for (int j = 0; j < visibleCols.Count; j++)
                {
                    var c = visibleCols[j];
                    var w = SkeletonWidth(c, rowIdx, j);
                    <td class="@CellCss(c)" style="@CellStyle(c)">
                        <span class="omni-skeleton omni-grid-skeleton-bar" style="@($"width: {w}%;")"></span>
                    </td>
                }
                @if (EditMode != DataGridEditMode.None) { <td class="omni-grid-edit-actions"></td> }
                @if (HasFillerColumn) { <td class="omni-grid-td-filler"></td> }
            </tr>
        }
    };

    /// <summary>
    /// Largura (%) da barra de skeleton para uma célula. Numéricas ficam mais
    /// estreitas; textuais mais largas. Jitter determinístico por (row, col) cria
    /// variação entre linhas sem random.
    /// </summary>
    private static int SkeletonWidth(OmniDataGridColumn<TItem> col, int rowIdx, int colIdx)
    {
        bool isNumeric = col.Aggregate is not null
            || ContainsAny(col.PropertyName, "id", "numero", "total", "price", "valor", "qtd", "count");
        var baseMin = isNumeric ? 45 : 65;
        var baseMax = isNumeric ? 65 : 90;
        var jitter = ((rowIdx * 7) + colIdx * 3) % (baseMax - baseMin);
        return baseMin + jitter;
    }

    private static bool ContainsAny(string? haystack, params string[] needles)
    {
        if (string.IsNullOrEmpty(haystack)) return false;
        foreach (var n in needles)
        {
            if (haystack.Contains(n, StringComparison.OrdinalIgnoreCase)) return true;
        }
        return false;
    }

    // ─── Column resize ────────────────────────────────────────────────────
    private DotNetObjectReference<OmniDataGrid<TItem>>? _selfRef;

    private async Task StartColumnResizeAsync(int visibleIndex, MouseEventArgs e)
    {
        _selfRef ??= DotNetObjectReference.Create(this);
        try
        {
            await GridInterop.StartColumnResizeAsync(
                ColUid(visibleIndex), _selfRef, visibleIndex, e.ClientX, 48);
        }
        catch { /* SSR / JS not ready */ }
    }

    /// <summary>Invoked from JS when a column resize drag finishes.</summary>
    [JSInvokable]
    public Task OnColumnResized(int visibleIndex, double width)
    {
        var cols = VisibleColumns.ToList();
        if (visibleIndex < 0 || visibleIndex >= cols.Count) return Task.CompletedTask;
        var col = cols[visibleIndex];
        col.SetWidth($"{Math.Round(width)}px");
        StateHasChanged();
        return ColumnResized.HasDelegate
            ? ColumnResized.InvokeAsync(new DataGridColumnResizedEventArgs(col.ResolvedPropertyName, width))
            : Task.CompletedTask;
    }

    public void Dispose()
    {
        if (Interlocked.Exchange(ref _disposeState, 1) != 0) return;

        var debounce = Interlocked.Exchange(ref _searchDebounceCts, null);
        CancelSafely(debounce);
        var load = Interlocked.Exchange(ref _loadCts, null);
        CancelSafely(load);
        CancelExport();
        _hierarchy.Dispose();
        _selfRef?.Dispose();
        _selfRef = null;
        GC.SuppressFinalize(this);
    }

    private static void CancelSafely(CancellationTokenSource? source)
    {
        if (source is null) return;

        try
        {
            source.Cancel();
        }
        catch (ObjectDisposedException)
        {
            // The operation owns disposal and may have completed concurrently.
        }
    }
}
