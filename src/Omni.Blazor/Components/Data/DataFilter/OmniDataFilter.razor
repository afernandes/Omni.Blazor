@namespace Omni.Blazor.Components
@typeparam TItem
@inherits OmniComponent
@implements IOmniDataFilterOwner
@inject Omni.Blazor.Services.ClipboardService Clipboard
@using Omni.Blazor.Models

@*
    OmniDataFilter — a typed visual query builder. DataFilterSchema<TItem>
    provides compile-time validated fields and DataFilterQuery<TItem> provides
    immutable, versioned persistence.

    Usage:
      <OmniDataFilter TItem="Person" Data="people" Schema="schema"
                      Filter="@(v => view = v.ToList())" />
*@

<CascadingValue Value="(IOmniDataFilterOwner)this" IsFixed="true">
    <div class="@RootCss" style="@Style" @attributes="Attributes">
        @if (AllowSqlMode)
        {
            <div class="omni-datafilter-modes" role="group" aria-label="@Texts.Mode">
                <button type="button" class="@ModeCss(false)" disabled="@Disabled" @onclick="@(() => SetSqlModeAsync(false))">
                    <OmniIcon Name="layout-grid" Size="ComponentSize.Sm" /> @EffectiveVisualModeText
                </button>
                <button type="button" class="@ModeCss(true)" disabled="@Disabled" @onclick="@(() => SetSqlModeAsync(true))">
                    <OmniIcon Name="code" Size="ComponentSize.Sm" /> @SqlModeText
                </button>
            </div>
        }

        @if (_sqlMode)
        {
            <div class="omni-datafilter-sql">
                <textarea class="omni-datafilter-sql-input" rows="4" spellcheck="false" autocomplete="off"
                          value="@_sqlText" @oninput="OnSqlInput" disabled="@Disabled"
                          placeholder="@EffectiveSqlPlaceholder" aria-label="@Texts.SqlFilter"></textarea>

                <div class="@SqlStatusCss" role="status">
                    @if (_sqlError is not null)
                    {
                        <OmniIcon Name="alert-triangle" Size="ComponentSize.Sm" /> <span>@_sqlError</span>
                    }
                    else
                    {
                        <OmniIcon Name="circle-check" Size="ComponentSize.Sm" /> <span>@EffectiveSqlValidText</span>
                    }
                </div>

                @if (_properties.Count > 0)
                {
                    <div class="omni-datafilter-sql-fields">
                        <span class="omni-datafilter-sql-fieldslabel">@EffectiveFieldsLabel:</span>
                        @foreach (var p in _properties)
                        {
                            <code class="omni-datafilter-sql-chip" @key="p">@p.Property</code>
                        }
                    </div>
                }

                <div class="omni-datafilter-actions">
                    <OmniButton Text="@EffCopyText" Icon="copy" Variant="ButtonVariant.Default"
                                Size="ComponentSize.Sm" OnClick="CopySqlAsync" Disabled="@Disabled" />
                    <OmniButton Text="@EffApplySqlText" Icon="check" Variant="ButtonVariant.Primary"
                                Size="ComponentSize.Sm" OnClick="ApplySqlAsync" Disabled="@(Disabled || _sqlError is not null)" />
                </div>
            </div>
        }
        else
        {
            <OmniDataFilterItem Rule="_root" IsRoot="true" />

            @if (!Auto || HasRules)
            {
                <div class="omni-datafilter-actions">
                    @if (!Auto)
                    {
                        <OmniButton Text="@EffApplyFilterText" Icon="filter" Variant="ButtonVariant.Primary"
                                    Size="ComponentSize.Sm" OnClick="ApplyFilterAsync" Disabled="@Disabled" />
                    }
                    @if (HasRules)
                    {
                        <OmniButton Text="@EffClearFilterText" Icon="x" Variant="ButtonVariant.Default"
                                    Size="ComponentSize.Sm" OnClick="ClearAsync" Disabled="@Disabled" />
                    }
                </div>
            }

            @if (ShowSqlPreview && HasRules)
            {
                <details class="omni-datafilter-sqlpreview">
                    <summary>@EffectiveSqlPreviewLabel</summary>
                    <div class="omni-datafilter-sqlpreview-body">
                        <pre>@CurrentSql</pre>
                        <OmniButton Text="@EffCopyText" Icon="copy" Variant="ButtonVariant.Default"
                                    Size="ComponentSize.Sm" OnClick="CopyPreviewAsync" Disabled="@Disabled" />
                    </div>
                </details>
            }
        }
    </div>
</CascadingValue>
