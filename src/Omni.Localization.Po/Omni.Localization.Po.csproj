<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Omni.Localization.Po</RootNamespace>
    <AssemblyName>Omni.Localization.Po</AssemblyName>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnablePackageValidation>true</EnablePackageValidation>
    <IsAotCompatible>true</IsAotCompatible>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PackageId>AndersonN.Omni.Localization.Po</PackageId>
    <Title>Omni.Localization PO/Gettext adapter</Title>
    <Description>Optional Orchard Core PO/Gettext provider for AndersonN.Omni.Localization.</Description>
    <PackageTags>localization;i18n;po;gettext;orchardcore;omni</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Omni.Localization\Omni.Localization.csproj" />
    <PackageReference Include="OrchardCore.Localization.Core" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
