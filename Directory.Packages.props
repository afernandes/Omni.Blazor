<Project>

  <!-- =====================================================================
       Central Package Management
       Single source of truth for every PackageReference version in the repo.
       Projects reference packages by ID only (no Version="..."). Use
       <PackageVersion Include="X" Version="1.2.3" /> here to set / bump.
       ===================================================================== -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="AI (Microsoft.Extensions.AI — IChatClient abstraction)">
    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="10.8.3" />
  </ItemGroup>

  <ItemGroup Label="ASP.NET Core / Blazor">
    <PackageVersion Include="Microsoft.AspNetCore.Components.Authorization" Version="10.0.10" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="10.0.10" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.10" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Localization.Abstractions" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Localization" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup Label="Optional localization adapters">
    <PackageVersion Include="OrchardCore.Localization.Core" Version="3.0.1" />
  </ItemGroup>

  <ItemGroup Label="Build tooling">
    <PackageVersion Include="AspNetCore.SassCompiler" Version="1.102.0" />
    <PackageVersion Include="MinVer" Version="7.0.0" />
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.400" />
  </ItemGroup>

  <ItemGroup Label="MCP server (Omni.Blazor.Mcp)">
    <PackageVersion Include="ModelContextProtocol" Version="2.1.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="bunit" Version="2.8.6" />
    <PackageVersion Include="AngleSharp" Version="1.5.2" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <!-- Held at 6.x: coverlet 7+ instruments .razor render code much more granularly,
         which changes the measured number (~73% vs ~80% for the same tests) and would
         break the calibrated >=80% gate. Bump deliberately when the gate is recalibrated. -->
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.61.0" />
    <PackageVersion Include="Deque.AxeCore.Playwright" Version="4.12.0" />
  </ItemGroup>

</Project>
